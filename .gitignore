# Результаты сборки
bin/
obj/
publish/

# Ключи защиты данных: ими подписываются cookie. Это секрет, в репозиторий не кладём.
App_Data/

# Журналы, которые пишет модуль IIS при stdoutLogEnabled="true"
logs/

# Локальные переопределения настроек на конкретной машине.
# Никогда не коммитить: сюда попадают адреса, имена групп и, в будущем, строки подключения к БД.
appsettings.Local.json
appsettings.Production.json

# Служебное от сред разработки
.vs/
.idea/
*.user
*.suo

# Папка, в которую собираются пакеты для переноса в сеть без интернета
offline-packages/
