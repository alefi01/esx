// Основной файл настроек.
//
// Да, в нём есть комментарии — провайдер конфигурации .NET их пропускает.
// Формально это уже не строгий JSON, но читать конфиг так гораздо проще.
//
// Настройки этого файла перекрываются файлом appsettings.<Environment>.json,
// а те, в свою очередь, переменными окружения. Правки здесь применяются
// после перезапуска пула приложений IIS.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Журнал входов и работы с AD. Поставьте "Debug", если разбираете проблему с аутентификацией.
      "Portal.Web": "Information"
    }
  },

  // Какие имена узла приложение принимает в заголовке Host.
  // "*" — любые: отбором занимаются привязки сайта в IIS.
  // Портал доступен по двум именам — ftp.domen.pro и коротком ftp,
  // поэтому при ужесточении здесь нужно перечислить оба:
  //   "AllowedHosts": "ftp.domen.pro;ftp"
  // Иначе вход по короткому имени перестанет работать.
  "AllowedHosts": "*",

  "ActiveDirectory": {
    "DomainFqdn": "domen.pro",

    // Короткое (NetBIOS) имя домена. Используется только как подсказка на форме входа.
    // Посмотреть можно командой:  nltest /dsgetdc:domen.pro
    "DomainNetBios": "DOMEN",

    // Корень поиска в каталоге. Для домена domen.pro это DC=domen,DC=pro.
    "BaseDn": "DC=domen,DC=pro",

    // Без членства в этой группе на портал не пускают вообще.
    "AccessGroup": "WebUsers",

    // Группа администраторов портала. Создайте её в AD и впишите точное имя (sAMAccountName).
    "AdminGroup": "WebAdmins",

    // Кто может публиковать объявления. Читать ленту могут все члены AccessGroup.
    "PublisherGroup": "WebPublishers",

    // Negotiate — пароль по сети не передаётся, сертификаты не нужны (рекомендуется).
    // Basic — простой bind, пароль идёт открытым текстом; допустим ТОЛЬКО с UseSsl=true.
    "AuthMode": "Negotiate",

    "Port": 389,
    "UseSsl": false,

    // Подпись и шифрование LDAP-трафика средствами Kerberos/NTLM. Работает только с Negotiate.
    "UseSigningAndSealing": true,

    "TimeoutSeconds": 10,
    "IncludeNestedGroups": true,

    // Куда идти, если офис по IP определить не удалось (например, вход по VPN).
    "FallbackDomainControllers": [ "192.168.96.3", "192.168.112.2" ]
  },

  "Offices": {
    // Офис по умолчанию для адресов вне известных подсетей.
    // Пусто — офис остаётся неизвестным, и работает FallbackDomainControllers.
    "DefaultOfficeCode": "",

    "Items": [
      {
        "Code": "office1",
        "Name": "Офис 1",
        "Subnets": [ "192.168.96.0/20" ],
        "DomainControllers": [ "192.168.96.3" ]
      },
      {
        "Code": "office2",
        "Name": "Офис 2",
        "Subnets": [ "192.168.112.0/20" ],
        "DomainControllers": [ "192.168.112.2" ]
      }
    ]
  },

  // Строки подключения. ЗДЕСЬ ИХ НЕТ И БЫТЬ НЕ ДОЛЖНО:
  // в строке подключения к PostgreSQL есть пароль, а этот файл лежит
  // в репозитории и попадает в резервные копии исходников.
  //
  // Настоящая строка подключения задаётся на сервере одним из двух способов:
  //   1) файлом C:\inetpub\ftp\appsettings.Production.json (он в .gitignore),
  //   2) переменной окружения ConnectionStrings__Portal в web.config.
  // Оба способа описаны в docs/07-этап-2-объявления.md.
  "ConnectionStrings": {
    "Portal": ""
  },

  "Database": {
    // Приводить схему базы к нужному виду при запуске приложения.
    // Избавляет от необходимости переносить на сервер инструмент dotnet-ef.
    // Выключить, если когда-нибудь появится второй веб-сервер.
    "ApplyMigrationsOnStartup": true,

    "CommandTimeoutSeconds": 30,
    "AnnouncementsPageSize": 20
  },

  "Storage": {
    // Где физически лежат файлы. Держите ЭТУ ПАПКУ ВНЕ каталога приложения,
    // иначе при обновлении порталом её можно случайно затереть.
    // Задаётся на сервере в appsettings.Production.json, например "D:\\PortalFiles".
    // Пусто — хранилище не настроено, загрузка и скачивание работать не будут.
    "RootPath": "",

    // Предел размера одного файла по умолчанию. У каждой папки может быть свой.
    // 0 — без ограничения.
    "DefaultMaxFileSizeMb": 50,

    // Верхний предел для всего портала. Больше него папке выставить нельзя.
    // 0 — предела нет вовсе; тогда ограничивают только IIS (web.config,
    // maxAllowedContentLength) и место на диске.
    //
    // В web.config сейчас стоит наибольшее допустимое для IIS значение,
    // поэтому менять размер достаточно здесь.
    "AbsoluteMaxFileSizeMb": 4096,

    // Сколько дней удалённые файлы лежат в корзине, прежде чем стереться.
    "TrashRetentionDays": 30,

    // Сколько дней хранить записи журнала действий. 0 — хранить вечно.
    "AuditRetentionDays": 180,

    // Общий выключатель фоновой уборки (автоочистка папок + вычистка корзины).
    "CleanupEnabled": true,
    "CleanupIntervalHours": 6,

    "AuditPageSize": 50

    // Список запрещённых расширений задан в коде (StorageOptions.BlockedExtensions).
    // Чтобы его изменить, добавьте сюда "BlockedExtensions": [ ".exe", ... ] —
    // массив заменяется целиком, перечисляйте все нужные значения.
  },

  "Security": {
    // Переключить в true ПОСЛЕ того, как HTTPS в IIS заработал.
    // Если включить раньше — получите бесконечный редирект и не сможете войти.
    "RequireHttps": false,

    // Включать только после RequireHttps=true и проверки сертификата:
    // браузеры запоминают HSTS надолго, откатить трудно.
    "UseHsts": false,
    "HstsMaxAgeDays": 1,

    "SessionHours": 8,

    // Защита доменных учёток от блокировки перебором через форму входа.
    // Держите это число ниже порога блокировки в доменной политике паролей.
    "MaxFailedLoginAttempts": 5,
    "LoginLockoutMinutes": 5
  }
}
