<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки для IIS.

  Этот файл кладётся рядом с опубликованным приложением. IIS сам приложение не
  выполняет: он передаёт запросы модулю ASP.NET Core (ANCM), а тот запускает
  наш процесс. Режим InProcess означает, что приложение работает внутри рабочего
  процесса IIS — так быстрее и проще, и клиентский IP виден напрямую.

  ВАЖНО: при публикации командой `dotnet publish` этот файл попадёт в выходную
  папку автоматически, но значение processPath/arguments SDK перепишет сам.
  Здесь они заданы для случая, когда файл правится вручную на сервере.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\Portal.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Боевое окружение: подробные страницы ошибок отключены. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Ограничение размера запроса на стороне IIS: 204 МБ.

        Оно должно быть НЕ МЕНЬШЕ, чем Storage:AbsoluteMaxFileSizeMb
        в appsettings.json (по умолчанию 200 МБ) плюс небольшой запас
        на служебные части multipart-запроса.

        Почему в двух местах. Это ограничение IIS, и оно срабатывает
        РАНЬШЕ приложения: если поднять предел только в appsettings.json,
        крупный файл оборвётся с ошибкой 404.13 ещё до того, как портал
        успеет сказать что-то понятное. Если поднять только здесь —
        файл дойдёт до приложения и будет отклонён уже им, но зря
        проехав по сети.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="213909504" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Убираем подсказку о том, какой сервер и версия используются. -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
