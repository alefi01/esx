<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки для IIS.

  Этот файл кладётся рядом с опубликованным приложением. IIS сам приложение не
  выполняет: он передаёт запросы модулю ASP.NET Core (ANCM), а тот запускает
  наш процесс. Режим InProcess означает, что приложение работает внутри рабочего
  процесса IIS — так быстрее и проще, и клиентский IP виден напрямую.

  ВАЖНО: при публикации командой `dotnet publish` этот файл попадёт в выходную
  папку автоматически, но значение processPath/arguments SDK перепишет сам.
  Здесь они заданы для случая, когда файл правится вручную на сервере.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\Portal.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Боевое окружение: подробные страницы ошибок отключены. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Ограничение размера запроса на стороне IIS: 4 ГБ без малого.

        Это наибольшее значение, которое IIS вообще принимает
        (4294967295 байт), — то есть здесь предел фактически снят,
        и настоящим ограничителем остаётся Storage:AbsoluteMaxFileSizeMb
        в appsettings.Production.json. Так задумано: менять предел
        в одном месте проще, чем помнить про два.

        Оно должно быть НЕ МЕНЬШЕ, чем Storage:AbsoluteMaxFileSizeMb
        плюс небольшой запас на служебные части multipart-запроса.

        Почему в двух местах. Это ограничение IIS, и оно срабатывает
        РАНЬШЕ приложения: если оставить его низким, крупный файл
        оборвётся с ошибкой 404.13 ещё до того, как портал успеет
        сказать что-то понятное.

        Отдельно про время. Файл на несколько гигабайт по каналу между
        офисами идёт долго, и IIS может оборвать соединение по времени
        простоя. Если такое случится, поднимайте connectionTimeout
        в настройках сайта — размер тут будет уже ни при чём.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Убираем подсказку о том, какой сервер и версия используются. -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
