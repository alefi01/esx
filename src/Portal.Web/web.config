<?xml version="1.0" encoding="utf-8"?>
<!--
  Настройки для IIS.

  Этот файл кладётся рядом с опубликованным приложением. IIS сам приложение не
  выполняет: он передаёт запросы модулю ASP.NET Core (ANCM), а тот запускает
  наш процесс. Режим InProcess означает, что приложение работает внутри рабочего
  процесса IIS — так быстрее и проще, и клиентский IP виден напрямую.

  ВАЖНО: при публикации командой `dotnet publish` этот файл попадёт в выходную
  папку автоматически, но значение processPath/arguments SDK перепишет сам.
  Здесь они заданы для случая, когда файл правится вручную на сервере.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\Portal.Web.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Боевое окружение: подробные страницы ошибок отключены. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        Ограничение размера запроса на стороне IIS. Сейчас 30 МБ —
        с большим запасом для формы входа.

        На этапе файлового хранилища это значение придётся поднимать,
        причём в ДВУХ местах: здесь и в самом приложении
        (ограничение на размер тела запроса в ASP.NET Core).
        Если поднять только в одном — загрузка крупных файлов
        будет обрываться без внятного сообщения.
      -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Убираем подсказку о том, какой сервер и версия используются. -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
