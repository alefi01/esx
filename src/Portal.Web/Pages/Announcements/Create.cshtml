@page
@model Portal.Web.Pages.Announcements.CreateModel
@{
    ViewData["Title"] = "Новое объявление";
}

<section class="view active">


<div class="card">
    <h1>Новое объявление</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert err" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert err"></div>

        <div class="field">
            <label asp-for="Input.Title">Заголовок</label>
            <input asp-for="Input.Title" autofocus maxlength="200" />
            <span asp-validation-for="Input.Title" class="err"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Body">Текст</label>
            <textarea asp-for="Input.Body" rows="12" maxlength="10000"></textarea>
            <span asp-validation-for="Input.Body" class="err"></span>
            <p class="hint">
                Обычный текст. Переносы строк сохраняются, ссылки вида
                <code>https://…</code> станут кликабельными автоматически.
                Разметка HTML не поддерживается намеренно — так объявление
                не сможет содержать вредоносный код.
            </p>
        </div>

        <div class="field">
            <label for="attachments">Вложения</label>
            <input type="file" id="attachments" name="attachments" multiple />
            <p class="hint">
                Картинки (png, jpg, gif, webp) показываются прямо в объявлении,
                остальные файлы — ссылкой на скачивание. Опасные расширения
                не принимаются, как и в файловом хранилище.
            </p>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn primary">Опубликовать</button>
            <a class="btn" asp-page="Index">Отмена</a>
        </div>
    </form>
</div>
</section>
