@page "{id:int}"
@model Portal.Web.Pages.Announcements.EditModel
@{
    ViewData["Title"] = "Изменение объявления";
}

<section class="view active">


<div class="card">
    <h1>Изменение объявления</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert err" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert err"></div>

        @* Номер объявления передаём скрытым полем. Права всё равно проверяются
           по записи из базы, так что подмена номера ничего не даст. *@
        <input type="hidden" asp-for="Input.Id" />

        <div class="field">
            <label asp-for="Input.Title">Заголовок</label>
            <input asp-for="Input.Title" autofocus maxlength="200" />
            <span asp-validation-for="Input.Title" class="err"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Body">Текст</label>
            @* data-format включает правое меню с выделением жирным
               и жёлтым. Разметка при этом остаётся обычным текстом:
               в базу уходят те же **звёздочки** и ==равно==, а в разметку
               их превращает уже вывод (PlainTextFormatter). Так объявление
               по-прежнему нельзя использовать, чтобы протащить в страницу
               чужой код. *@
            <textarea asp-for="Input.Body" rows="12" maxlength="10000" data-format></textarea>
            <span asp-validation-for="Input.Body" class="err"></span>
            <span class="hint">
                Правое нажатие по тексту — выделение <strong>жирным</strong> и
                <mark>жёлтым</mark>. Их же можно набрать руками:
                <code>**жирный**</code> и <code>==жёлтый==</code>.
            </span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn primary">Сохранить</button>
            <a class="btn" asp-page="Index">Отмена</a>
        </div>
    </form>
</div>
</section>
