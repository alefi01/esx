@page "{id:int}"
@model Portal.Web.Pages.Announcements.EditModel
@{
    ViewData["Title"] = "Изменение объявления";
}

<div class="card">
    <h1>Изменение объявления</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert--error" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

        @* Номер объявления передаём скрытым полем. Права всё равно проверяются
           по записи из базы, так что подмена номера ничего не даст. *@
        <input type="hidden" asp-for="Input.Id" />

        <div class="field">
            <label asp-for="Input.Title">Заголовок</label>
            <input asp-for="Input.Title" autofocus maxlength="200" />
            <span asp-validation-for="Input.Title" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Body">Текст</label>
            <textarea asp-for="Input.Body" rows="12" maxlength="10000"></textarea>
            <span asp-validation-for="Input.Body" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="button button--primary button--inline">Сохранить</button>
            <a class="button" asp-page="Index">Отмена</a>
        </div>
    </form>
</div>
