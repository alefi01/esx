@page
@using Portal.Web.Pages.Shared
@model Portal.Web.Pages.Announcements.IndexModel
@{
    ViewData["Title"] = "Объявления";
}

<section class="view active ann-page">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <span data-flash="@Model.StatusMessage" data-flash-kind="ok" hidden></span>
    }

    <div class="view-head">
        <h2>Объявления</h2>

        @* Отбор — тремя ссылками, а не выпадающим списком: вариантов три,
           и лишнее нажатие «раскрыть список» здесь ничего не экономит.
           Ссылки, а не кнопки: каждый вид ленты имеет свой адрес. *@
        <nav class="seg" aria-label="Что показывать">
            <a class="seg-btn@(Model.FilterMode == "all" ? " on" : "")" asp-page="Index">Все</a>
            <a class="seg-btn@(Model.FilterMode == "pinned" ? " on" : "")"
               asp-page="Index" asp-route-filter="pinned">
                <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-pin" /></svg>Закреплённые
            </a>
            <a class="seg-btn@(Model.FilterMode == "important" ? " on" : "")"
               asp-page="Index" asp-route-filter="important">
                <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-alert" /></svg>Важные
            </a>
        </nav>

        @if (Model.CanPublish)
        {
            <a class="btn primary head-form" asp-page="Create">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-plus" /></svg>Создать объявление
            </a>
        }
    </div>

    @if (Model.DatabaseUnavailable)
    {
        <div class="alert err" role="alert">
            <strong>Объявления сейчас недоступны.</strong>
            Не удалось получить данные — сообщите администратору.
            Остальные разделы портала работают.

            @if (Model.DatabaseErrorDetail is not null)
            {
                @* Один элемент, а не <br> с <code> подряд: разметочный блок
                   внутри @@if должен начинаться с обычного парного тега,
                   иначе Razor принимает продолжение за код. *@
                <p><code>@Model.DatabaseErrorDetail</code></p>
            }
        </div>
    }

    @if (Model.Items.Count == 0 && !Model.DatabaseUnavailable)
    {
        <div class="empty">
            <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-mega" /></svg>
            @if (Model.FilterMode == "pinned")
            {
                <b>Закреплённых объявлений нет</b>
                <p>Закрепить объявление наверху ленты может тот, кто вправе его исправить</p>
            }
            else if (Model.FilterMode == "important")
            {
                <b>Важных объявлений нет</b>
                <p>Пометка «важное» ставится тем же, кто вправе исправить объявление</p>
            }
            else
            {
                <b>Объявлений пока нет</b>
                <p>Здесь появятся сообщения, которые должны увидеть все сотрудники</p>
            }
        </div>
    }
    else
    {
        @* Закреплённое отделено заголовком, а не только рамкой: иначе
           «почему это объявление первое» приходится угадывать по цвету
           обводки. Разделяем только в общей ленте и только на первой
           странице — дальше закреплённое уже кончилось. *@
        @if (Model.PinnedItems.Count > 0)
        {
            <h3 class="side-head">Закреплённое</h3>

            <div class="ann-list">
                @foreach (var item in Model.PinnedItems)
                {
                    @await Html.PartialAsync("_Announcement", new AnnouncementCard(item, Model.CanModify(item)))
                }
            </div>
        }

        @if (Model.RestItems.Count > 0)
        {
            @if (Model.PinnedItems.Count > 0)
            {
                <h3 class="side-head ann-head-rest">Лента</h3>
            }

            <div class="ann-list">
                @foreach (var item in Model.RestItems)
                {
                    @await Html.PartialAsync("_Announcement", new AnnouncementCard(item, Model.CanModify(item)))
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="Страницы">
                @if (Model.PageNumber > 1)
                {
                    <a asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-filter="@Model.Filter">← Новее</a>
                }

                <span>Страница @Model.PageNumber из @Model.TotalPages · всего @Model.TotalCount</span>

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-filter="@Model.Filter">Старее →</a>
                }
            </nav>
        }
    }
</section>
