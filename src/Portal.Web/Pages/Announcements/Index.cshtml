@page
@model Portal.Web.Pages.Announcements.IndexModel
@{
    ViewData["Title"] = "Объявления";
}

<div class="narrow">
<div class="page-header">
    <h1>Объявления</h1>

    @if (Model.CanPublish)
    {
        <a class="btn btn--primary" asp-page="Create">
            <svg class="icon"><use href="#i-pen"></use></svg>
            Написать объявление
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert--ok" role="status">@Model.StatusMessage</div>
}

@if (Model.DatabaseUnavailable)
{
    <div class="alert alert--error" role="alert">
        <strong>Объявления сейчас недоступны.</strong>
        Не удалось получить данные — сообщите администратору.
        Остальные разделы портала работают.

        @if (Model.DatabaseErrorDetail is not null)
        {
            <br />
            <span class="hint">Техническая подробность (видна только администраторам):</span>
            <code>@Model.DatabaseErrorDetail</code>
        }
    </div>
}

@if (Model.Items.Count == 0 && !Model.DatabaseUnavailable)
{
    <div class="card">
        <p class="hint">Объявлений пока нет.</p>
    </div>
}

@foreach (var item in Model.Items)
{
    @await Html.PartialAsync("_Announcement",
        new Portal.Web.Pages.Shared.AnnouncementCard(item, Model.CanModify(item)))
}

@if (Model.TotalPages > 1)
{
    <nav class="pager">
        @if (Model.PageNumber > 1)
        {
            <a asp-page="Index" asp-route-pageNumber="@(Model.PageNumber - 1)">← Новее</a>
        }

        <span class="hint">Страница @Model.PageNumber из @Model.TotalPages</span>

        @if (Model.PageNumber < Model.TotalPages)
        {
            <a asp-page="Index" asp-route-pageNumber="@(Model.PageNumber + 1)">Старее →</a>
        }
    </nav>
}
</div>
