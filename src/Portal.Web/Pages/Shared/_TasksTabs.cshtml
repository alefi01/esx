@using Microsoft.Extensions.Options
@using Portal.Web.Configuration
@model Portal.Web.Pages.Shared.TasksTabs
@inject IOptions<ActiveDirectoryOptions> AdOptions

@*
    Вкладки раздела «Задачи».

    «Мои» — свои заметки, их человек ведёт сам.
    «От руководителя» — поручения: их сдают, и закрывает их тот, кто
    поставил. Вкладка есть у того, кому хоть раз что-то поручали:
    начальник тоже бывает чьим-то подчинённым, так что убирать её
    по должности нельзя, а обещать пустой раздел тому, кому никто
    ничего не поручал, незачем.
    «Подчинённым» — то, что человек поручил другим. Видна только тем,
    кто вправе ставить задачи: у остальных этой половины раздела просто
    нет, и вкладка из воздуха сбивала бы с толку.

    Право то же, что у политики AssignTasks: членство в группе
    начальников или администратор. Считается здесь так же, как в меню,
    и по той же причине: страница не должна предлагать то, что сервер
    всё равно не пустит.
*@
@{
    var canAssign = User.IsInRole(AdOptions.Value.AdminGroup)
                    || User.IsInRole(AdOptions.Value.HeadGroup);
}

<nav class="seg" aria-label="Чьи задачи">
    <a class="seg-btn@(Model.Current == "own" ? " on" : "")" asp-page="/Tasks/Index">
        <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check-square" /></svg>Мои
    </a>

    @if (Model.HasHead || Model.Current == "head")
    {
        <a class="seg-btn@(Model.Current == "head" ? " on" : "")" asp-page="/Tasks/Index" asp-route-scope="head">
            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-users" /></svg>От руководителя
            @if (Model.HeadCount > 0)
            {
                <span class="side-count">@Model.HeadCount</span>
            }
        </a>
    }

    @if (canAssign)
    {
        <a class="seg-btn@(Model.Current == "assigned" ? " on" : "")" asp-page="/Tasks/Assigned">
            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-sliders" /></svg>Подчинённым
            @if (Model.WaitingCount > 0)
            {
                <span class="side-count">@Model.WaitingCount</span>
            }
        </a>
    }
</nav>
