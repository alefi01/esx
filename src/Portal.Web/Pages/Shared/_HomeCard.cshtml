@using Portal.Web.Data
@using Portal.Web.Services.Text
@inject PlainTextFormatter TextFormatter
@model Portal.Web.Services.Announcements.FeedItem

@*
    Карточка объявления НА ГЛАВНОЙ — одна и та же в обоих столбцах.

    Раньше слева стояли полные карточки ленты (со значками, аватаром
    и кнопками), а справа — короткие. Столбцы получались разной высоты
    строки и разного отступа, и рядом друг с другом это читалось как
    съехавшая вёрстка. Теперь вид один, и строки в столбцах совпадают.

    Адреса в ссылки здесь НЕ превращаются: вся карточка сама по себе
    ссылка, а ссылка внутри ссылки — недопустимая разметка, браузер молча
    разрывает внешнюю и карточка разваливается. А вот выделение (жирным
    и жёлтым) работает: оно ничего не ломает, и без него объявление
    с пометками выглядело на главной как текст со звёздочками.
    Полный текст с рабочими ссылками и вложениями — в ленте объявлений,
    куда карточка и ведёт.
*@
@{
    var item = Model.Item;
    var folder = Model.Folder;
}

@* Карточка ведёт В ПАПКУ, на которой висит объявление: отдельной ленты
   больше нет, и полный текст с вложениями живёт там. Заодно переход
   отмечает объявления папки прочитанными — поэтому карточка с главной
   пропадает ровно тогда, когда человек её прочитал, а не когда
   заглянул на главную. *@
<a class="pin-card@(item.IsImportant ? " important" : "")"
   asp-page="/Files/Index" asp-route-id="@folder?.Id" asp-fragment="@($"a{item.Id}")">
    <b>@item.Title</b>
    <span class="pin-body">@TextFormatter.ToMarkedText(item.Body)</span>
    <span class="pin-foot">
        @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy") · @item.AuthorDisplayName
        @if (folder is not null)
        {
            <text> · @folder.Name</text>
        }
    </span>
</a>
