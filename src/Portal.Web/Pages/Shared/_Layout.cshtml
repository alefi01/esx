@using Microsoft.Extensions.Options
@using Portal.Web.Configuration
@using Portal.Web.Services.Storage
@inject IOptions<ActiveDirectoryOptions> AdOptions
@inject StorageUsage Usage
@{
    var adminGroup = AdOptions.Value.AdminGroup;
    var isAdmin = User.IsInRole(adminGroup);
    var signedIn = User.Identity?.IsAuthenticated == true;

    // Занятое место для карточки внизу меню. Значение общее для всех
    // и лежит в памяти минуту, поэтому запроса к базе на каждой странице
    // здесь нет — см. комментарий в StorageUsage.
    var usage = signedIn
        ? await Usage.GetAsync(Context.RequestAborted)
        : new StorageUsageInfo(0, 0, 0, Known: false);

    var path = Context.Request.Path.Value ?? "/";

    // Подсветка текущего раздела. Сравниваем по началу пути, чтобы «Файлы»
    // оставались выделенными и внутри вложенных папок. Разделы под /Files
    // проверяются отдельно: иначе «Корзина» зажигала бы и «Файлы» тоже.
    string Nav(string prefix)
    {
        if (prefix == "/")
        {
            return path == "/" ? " active" : "";
        }

        if (!path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        if (prefix.Equals("/Files", StringComparison.OrdinalIgnoreCase)
            && path.StartsWith("/Files/", StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        return " active";
    }

    var displayName = User.Identity?.Name ?? "";
    var initials = Portal.Web.Pages.Shared.Avatars.Initials(displayName);
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] — Портал</title>

    @* Стили, шрифт и код лежат локально: внешние CDN в вашей сети недоступны. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Тема подключается ЗДЕСЬ, в <head>, до отрисовки страницы. Иначе
       человек с тёмной темой на долю секунды увидит светлый фон. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>

@* Набор значков подключается один раз и дальше используется по ссылке. *@
<partial name="_Icons" />

@* ====================== Верхняя полоса ====================== *@
<header class="topbar">
    <button class="icon-btn burger" id="burgerBtn" type="button" aria-label="Меню">
        <svg class="ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><use href="#i-menu" /></svg>
    </button>

    <a class="brand" asp-page="/Index">
        <div class="brand-logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-folder" /></svg></div>
        <div>Портал<small>корпоративный портал</small></div>
    </a>

    @if (signedIn)
    {
        @* Поиск по файлам. Обычная форма методом GET: работает и без
           JavaScript, а адрес результата можно послать коллеге ссылкой. *@
        <form class="searchbar" method="get" asp-page="/Files/Index" role="search">
            <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-search" /></svg>
            <input id="globalSearch" type="text" name="q" placeholder="Поиск файлов и папок…" aria-label="Поиск файлов и папок" />
            <kbd>Ctrl K</kbd>
        </form>
    }

    <div class="top-actions">
        @if (signedIn)
        {
            <button class="icon-btn" id="themeBtn" type="button" title="Сменить тему">
                <svg class="ic" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><use href="#i-moon" id="themeIconUse" /></svg>
            </button>

            @* Список уведомлений наполняет код страницы: он раз в минуту
               спрашивает сервер, нет ли нового. Здесь только заготовка. *@
            <div class="notif-wrap">
                <button class="icon-btn" id="bellBtn" type="button" title="Уведомления">
                    <svg class="ic" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-bell" /></svg>
                    <span class="badge-dot" id="bellBadge" hidden>0</span>
                </button>
                <div class="notif-panel" id="notifPanel" hidden></div>
            </div>

            <div class="user-chip" id="userChip">
                <div class="avatar" data-av="@Portal.Web.Pages.Shared.Avatars.ColorIndex(displayName)">@initials</div>
                <div class="u-meta">
                    <b>@displayName</b>
                    <span>@(isAdmin ? "Администратор" : "Сотрудник")</span>
                </div>
            </div>

            @* Выход только POST-ом — см. комментарий в Logout.cshtml.cs.
               Tag helper сам добавит в форму antiforgery-токен. *@
            <form method="post" asp-page="/Account/Logout" class="logout-form">
                <button class="icon-btn" type="submit" title="Выйти">
                    <svg class="ic" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-restore" /></svg>
                </button>
            </form>
        }
    </div>
</header>

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="nav-label">Рабочее пространство</div>

        <a class="nav-item@(Nav("/"))" asp-page="/Index">
            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><use href="#i-home" /></svg>Главная
        </a>

        <a class="nav-item@(Nav("/Files"))" asp-page="/Files/Index">
            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><use href="#i-folder" /></svg>Файлы
        </a>

        <a class="nav-item@(Nav("/Files/Favorites"))" asp-page="/Files/Favorites">
            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><use href="#i-star" /></svg>Избранное
        </a>

        <a class="nav-item@(Nav("/Messages"))" asp-page="/Messages/Index">
            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><use href="#i-chat" /></svg>Чат<span class="cnt" id="chatBadge" hidden>0</span>
        </a>

        <div class="nav-label">Организация</div>

        <a class="nav-item@(Nav("/Announcements"))" asp-page="/Announcements/Index">
            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><use href="#i-mega" /></svg>Объявления<span class="cnt" id="annBadge" hidden>0</span>
        </a>

        @* Лента активности видна только администратору: по ней понятно,
           кто чем занимается, и сотрудникам друг о друге это знать незачем.
           Остальным пункт не показывается вовсе. *@
        @if (isAdmin)
        {
            <a class="nav-item@(Nav("/Admin/Activity"))" asp-page="/Admin/Activity">
                <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><use href="#i-clock" /></svg>Активность
            </a>
        }

        <div class="nav-label">Сервис</div>

        <a class="nav-item@(Nav("/Files/Trash"))" asp-page="/Files/Trash">
            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trash" /></svg>Корзина
        </a>

        @if (isAdmin)
        {
            <a class="nav-item@(Nav("/Admin/Audit"))" asp-page="/Admin/Audit">
                <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-eye" /></svg>Журнал
            </a>

            <a class="nav-item@(Nav("/Admin/Diagnostics"))" asp-page="/Admin/Diagnostics">
                <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-info" /></svg>Диагностика
            </a>
        }

        @* Карточка «сколько занято». Общий объём задаётся настройкой
           Storage:TotalCapacityGb; портал по ней ничего не запрещает —
           она нужна, чтобы цифру было с чем сравнить. *@
        <div class="storage-card">
            <b>Хранилище</b>
            <p id="storageText">@usage.Caption</p>
            @* Ширину полосы проставляет код страницы по data-percent:
               встроенные стили запрещены политикой безопасности. *@
            <div class="bar"><i id="storageBar" data-percent="@((int)Math.Round(usage.Fraction * 100))"></i></div>
        </div>
    </aside>

    <main class="main">
        @RenderBody()
    </main>
</div>

@* Корни для всплывающих сообщений и окон — как в макете. *@
<div id="toastRoot"></div>
<div id="modalRoot"></div>

<script src="~/js/app.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
