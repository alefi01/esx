@using Microsoft.Extensions.Options
@using Portal.Web.Configuration
@inject IOptions<ActiveDirectoryOptions> AdOptions
@{
    var adminGroup = AdOptions.Value.AdminGroup;

    // Подсветка текущего раздела в меню. Сравниваем по началу пути,
    // чтобы «Файлы» оставались выделенными и внутри вложенных папок.
    var path = Context.Request.Path.Value ?? "/";

    string NavClass(string prefix) =>
        prefix == "/"
            ? (path == "/" ? "is-active" : "")
            : (path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "is-active" : "");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] — Портал</title>
    @* Стили и код лежат локально: внешние CDN в вашей сети недоступны. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Выбор темы подключается ЗДЕСЬ, в <head>, а не вместе с остальным кодом
       внизу страницы. Иначе человек с тёмной темой на долю секунды увидит
       светлый фон — некрасивая вспышка при каждом переходе. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body>
@* Набор значков подключается один раз и дальше используется по ссылке. *@
<partial name="_Icons" />

<header class="topbar">
    <a class="topbar__brand" asp-page="/Index">
        <svg class="icon"><use href="#i-folder"></use></svg>
        Портал
    </a>

    <nav class="topbar__nav">
        <a class="@NavClass("/")" asp-page="/Index">Главная</a>
        <a class="@NavClass("/Announcements")" asp-page="/Announcements/Index">Объявления</a>
        <a class="@NavClass("/Files")" asp-page="/Files/Index">Файлы</a>
        @if (User.IsInRole(adminGroup))
        {
            <a class="@NavClass("/Admin/Audit")" asp-page="/Admin/Audit">Журнал</a>
            <a class="@NavClass("/Admin/Diagnostics")" asp-page="/Admin/Diagnostics">Диагностика</a>
        }
    </nav>

    <div class="topbar__user">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @* ---------- Колокольчик ----------
               Список наполняется кодом страницы: она раз в минуту спрашивает
               сервер, нет ли нового. В разметке — только пустая заготовка. *@
            <div class="bell" data-bell>
                <button type="button" class="iconbtn" data-bell-toggle
                        aria-haspopup="true" aria-expanded="false" title="Уведомления">
                    <svg class="icon"><use href="#i-bell"></use></svg>
                    <span class="bell__badge" data-bell-badge hidden>0</span>
                </button>

                <div class="bell__panel" data-bell-panel hidden role="menu">
                    <div class="bell__head">
                        <strong>Уведомления</strong>
                        <button type="button" class="button button--link" data-bell-clear>Прочитано</button>
                    </div>

                    <div class="bell__list" data-bell-list></div>
                </div>
            </div>

            @* ---------- Переключатель темы ----------
               Значок и подпись расставляет код страницы: сервер не знает,
               какую тему выбрал человек, — выбор хранится в браузере. *@
            <button type="button" class="iconbtn" data-theme-toggle title="Тема оформления">
                <svg class="icon"><use href="#i-theme-auto" data-theme-icon></use></svg>
            </button>

            <span class="topbar__name">@User.Identity?.Name</span>

            @* Выход только POST-ом — см. комментарий в Logout.cshtml.cs.
               Tag helper сам добавит в форму antiforgery-токен. *@
            <form method="post" asp-page="/Account/Logout" class="inline-form">
                <button type="submit" class="button button--link">Выйти</button>
            </form>
        }
    </div>
</header>

<main class="page">
    @RenderBody()
</main>

<footer class="footer">
    Корпоративный портал · этап 3 (файловое хранилище)
</footer>

@* Окно подтверждения: используется вместо системного окна браузера,
   чтобы опасные действия выглядели одинаково на всех страницах. *@
<div class="modal" data-modal="confirm" hidden>
    <div class="modal__backdrop" data-modal-close></div>

    <div class="modal__window" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
        <h2 id="confirm-title" data-confirm-title>Подтвердите действие</h2>
        <p data-confirm-text></p>

        <div class="modal__actions">
            <button type="button" class="btn" data-modal-close>Отмена</button>
            <button type="button" class="btn btn--danger" data-confirm-ok>Удалить</button>
        </div>
    </div>
</div>

<script src="~/js/app.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
