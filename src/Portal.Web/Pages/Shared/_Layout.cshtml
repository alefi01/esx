@using Microsoft.Extensions.Options
@using Portal.Web.Configuration
@using Portal.Web.Services.Storage
@inject IOptions<ActiveDirectoryOptions> AdOptions
@inject StorageUsage Usage
@{
    var adminGroup = AdOptions.Value.AdminGroup;
    var isAdmin = User.IsInRole(adminGroup);

    // Занятое место для карточки внизу меню. Значение общее для всех
    // и лежит в памяти минуту, поэтому запроса к базе на каждой странице
    // здесь нет — см. комментарий в StorageUsage.
    var usage = await Usage.GetAsync(Context.RequestAborted);

    // Подсветка текущего раздела в меню. Сравниваем по началу пути,
    // чтобы «Файлы» оставались выделенными и внутри вложенных папок.
    var path = Context.Request.Path.Value ?? "/";

    string NavClass(string prefix)
    {
        if (prefix == "/")
        {
            return path == "/" ? "is-active" : "";
        }

        if (!path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        // «Файлы» не должны подсвечиваться, когда открыта корзина или
        // настройки папки: у них свои пункты меню, и подсвечиваться должен
        // ровно один. Без этой проверки «/Files/Trash» зажигал бы оба.
        if (prefix.Equals("/Files", StringComparison.OrdinalIgnoreCase)
            && path.StartsWith("/Files/", StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        return "is-active";
    }
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] — Портал</title>
    @* Стили и код лежат локально: внешние CDN в вашей сети недоступны. *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Выбор темы подключается ЗДЕСЬ, в <head>, а не вместе с остальным кодом
       внизу страницы. Иначе человек с тёмной темой на долю секунды увидит
       светлый фон — некрасивая вспышка при каждом переходе. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
@* Класс app-shell включает «оконный» режим: шапка и меню стоят на месте,
   прокручивается только середина. У страницы входа разметка другая. *@
<body class="app-shell">
@* Набор значков подключается один раз и дальше используется по ссылке. *@
<partial name="_Icons" />

@* ====================== Верхняя полоса ====================== *@
<header class="topbar">
    @* Кнопка бокового меню. Видна только на узком экране — на широком
       меню и так на месте, прятать его незачем. *@
    <button type="button" class="iconbtn burger" data-sidebar-toggle
            aria-label="Меню" aria-expanded="false">
        <svg class="icon"><use href="#i-menu"></use></svg>
    </button>

    <a class="topbar__brand" asp-page="/Index">
        <span class="topbar__logo"><svg class="icon"><use href="#i-folder"></use></svg></span>
        <span>Портал</span>
    </a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @* Поиск по файлам. Обычная форма с методом GET: работает и без
           JavaScript, а адрес результата можно послать коллеге ссылкой. *@
        <form class="topsearch" method="get" asp-page="/Files/Index" role="search">
            <span class="topsearch__icon"><svg class="icon icon--xs"><use href="#i-search"></use></svg></span>
            <input type="search" name="q" placeholder="Поиск по файлам"
                   aria-label="Поиск по файлам" data-global-search />
            <span class="topsearch__hint"><kbd>Ctrl</kbd><kbd>K</kbd></span>
        </form>
    }

    <div class="topbar__tools">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @* ---------- Колокольчик ----------
               Список наполняется кодом страницы: она раз в минуту спрашивает
               сервер, нет ли нового. В разметке — только пустая заготовка. *@
            <div class="bell" data-bell>
                <button type="button" class="iconbtn" data-bell-toggle
                        aria-haspopup="true" aria-expanded="false" title="Уведомления">
                    <svg class="icon"><use href="#i-bell"></use></svg>
                    <span class="bell__badge" data-bell-badge hidden>0</span>
                </button>

                <div class="bell__panel" data-bell-panel hidden role="menu">
                    <div class="bell__head">
                        <strong>Уведомления</strong>
                        <button type="button" class="button button--link" data-bell-clear>Прочитано</button>
                    </div>

                    <div class="bell__list" data-bell-list></div>
                </div>
            </div>

            @* ---------- Переключатель темы ----------
               Значок и подпись расставляет код страницы: сервер не знает,
               какую тему выбрал человек, — выбор хранится в браузере. *@
            <button type="button" class="iconbtn" data-theme-toggle title="Тема оформления">
                <svg class="icon"><use href="#i-theme-auto" data-theme-icon></use></svg>
            </button>

            <span class="topbar__name">@User.Identity?.Name</span>

            @* Выход только POST-ом — см. комментарий в Logout.cshtml.cs.
               Tag helper сам добавит в форму antiforgery-токен. *@
            <form method="post" asp-page="/Account/Logout" class="inline-form">
                <button type="submit" class="iconbtn" title="Выйти" aria-label="Выйти">
                    <svg class="icon"><use href="#i-open"></use></svg>
                </button>
            </form>
        }
    </div>
</header>

<div class="shell">

    @* ====================== Боковое меню ====================== *@
    <aside class="sidebar" data-sidebar>
        <nav class="nav-group">
            <div class="nav-title">Рабочее пространство</div>

            <a class="nav-item @NavClass("/")" asp-page="/Index">
                <svg class="icon"><use href="#i-home"></use></svg>
                Главная
            </a>

            <a class="nav-item @NavClass("/Files")" asp-page="/Files/Index">
                <svg class="icon"><use href="#i-folder"></use></svg>
                Файлы
            </a>

            <a class="nav-item @NavClass("/Files/Favorites")" asp-page="/Files/Favorites">
                <svg class="icon"><use href="#i-star"></use></svg>
                Избранное
            </a>

            <a class="nav-item @NavClass("/Messages")" asp-page="/Messages/Index">
                <svg class="icon"><use href="#i-chat"></use></svg>
                Чат
                @* Число непрочитанных проставляет код страницы после опроса
                   сервера — здесь только место под него. *@
                <span class="nav-item__count nav-item__count--alert" data-nav-count="message" hidden>0</span>
            </a>
        </nav>

        <nav class="nav-group">
            <div class="nav-title">Организация</div>

            <a class="nav-item @NavClass("/Announcements")" asp-page="/Announcements/Index">
                <svg class="icon"><use href="#i-mega"></use></svg>
                Объявления
                <span class="nav-item__count" data-nav-count="announcement" hidden>0</span>
            </a>

            @* Лента активности видна только администратору: по ней понятно,
               кто чем занимается, и сотрудникам друг о друге это знать незачем.
               Остальным пункт не показывается вовсе. *@
            @if (isAdmin)
            {
                <a class="nav-item @NavClass("/Admin/Activity")" asp-page="/Admin/Activity">
                    <svg class="icon"><use href="#i-clock"></use></svg>
                    Активность
                </a>
            }
        </nav>

        <nav class="nav-group">
            <div class="nav-title">Сервис</div>

            <a class="nav-item @NavClass("/Files/Trash")" asp-page="/Files/Trash">
                <svg class="icon"><use href="#i-trash"></use></svg>
                Корзина
            </a>

            @if (isAdmin)
            {
                <a class="nav-item @NavClass("/Admin/Audit")" asp-page="/Admin/Audit">
                    <svg class="icon"><use href="#i-shield"></use></svg>
                    Журнал
                </a>

                <a class="nav-item @NavClass("/Admin/Diagnostics")" asp-page="/Admin/Diagnostics">
                    <svg class="icon"><use href="#i-settings"></use></svg>
                    Диагностика
                </a>
            }
        </nav>

        @* Карточка «сколько занято». Общий объём задаётся настройкой
           Storage:TotalCapacityGb; портал по ней ничего не запрещает —
           она нужна только чтобы цифру было с чем сравнить. *@
        <div class="storage-card">
            <div class="storage-card__head">
                <svg class="icon"><use href="#i-info"></use></svg>
                Хранилище
            </div>

            @if (usage.ShowBar)
            {
                @* Ширину полосы проставляет код страницы по data-percent:
                   встроенные стили запрещены политикой безопасности. *@
                <div class="bar">
                    <i class="@(usage.IsNearlyFull ? "is-full" : "")"
                       data-percent="@((int)Math.Round(usage.Fraction * 100))"></i>
                </div>
            }

            <div class="storage-card__text">@usage.Caption</div>
        </div>
    </aside>

    @* Затемнение под выдвинутым меню на узком экране. *@
    <div class="scrim" data-sidebar-close></div>

    @* ====================== Содержимое ====================== *@
    <main class="view">
        @RenderBody()
    </main>
</div>

@* Окно подтверждения: используется вместо системного окна браузера,
   чтобы опасные действия выглядели одинаково на всех страницах. *@
<div class="modal" data-modal="confirm" hidden>
    <div class="modal__backdrop" data-modal-close></div>

    <div class="modal__window" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title">
        <h2 id="confirm-title" data-confirm-title>Подтвердите действие</h2>
        <p data-confirm-text></p>

        <div class="modal__actions">
            <button type="button" class="btn" data-modal-close>Отмена</button>
            <button type="button" class="btn btn--danger" data-confirm-ok>Удалить</button>
        </div>
    </div>
</div>

<script src="~/js/app.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
