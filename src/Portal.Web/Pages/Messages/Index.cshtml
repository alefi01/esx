@page
@using Portal.Web.Pages.Shared
@using Portal.Web.Services.Messaging
@model Portal.Web.Pages.Messages.IndexModel
@{
    ViewData["Title"] = Model.Current is null ? "Чат" : Model.Title;
}

@*
    Переписки — разметка из макета.

    Данные для кода страницы передаются через data-атрибуты, а не через
    вставленный <script>: политика безопасности запрещает встроенные
    скрипты, и это правильно.
*@
<section class="view chat-view active"
         data-chat
         data-conversation="@(Model.Current?.Id.ToString() ?? "")"
         data-last-message="@(Model.Items.Count > 0 ? Model.Items[^1].Id : 0)"
         data-me="@Model.UserName"
         data-title="@Model.Title"
         data-can-write="@Model.CanWrite.ToString().ToLowerInvariant()"
         data-is-owner="@Model.IsOwner.ToString().ToLowerInvariant()"
         data-is-group="@((Model.Current?.IsGroup ?? false).ToString().ToLowerInvariant())">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <span data-flash="@Model.StatusMessage" data-flash-kind="ok" hidden></span>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <span data-flash="@Model.ErrorMessage" data-flash-kind="danger" hidden></span>
    }

    <div class="chat-layout">

        @* ---------- Слева: список бесед ---------- *@
        <div class="convo-list">
            <div class="convo-head">
                <b>Сообщения</b>

                <button class="btn sm" type="button" id="newDirectBtn" title="Написать сотруднику">
                    <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-edit" /></svg>Написать
                </button>

                <button class="btn sm primary" type="button" id="newGroupBtn" title="Создать группу">
                    <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><use href="#i-plus" /></svg>Группа
                </button>
            </div>

            @* Поиск. Обычная форма методом GET: адрес результата можно
               послать коллеге и вернуть кнопкой «назад». *@
            <form class="convo-search" method="get" role="search">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-search" /></svg>
                <input type="search" name="q" value="@Model.Query" autocomplete="off"
                       placeholder="Поиск по перепискам и сообщениям" aria-label="Поиск" />
            </form>

            <div class="convo-scroll">
                @if (Model.Conversations.Count == 0 && !Model.IsSearching)
                {
                    <div class="empty convo-empty">
                        <svg class="ic" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-chat" /></svg>
                        <b>Переписок пока нет</b>
                        <p>Нажмите «Написать», чтобы начать</p>
                    </div>
                }

                @foreach (var item in Model.Conversations)
                {
                    <a class="convo@(Model.Current?.Id == item.Id ? " active" : "")"
                       asp-page="Index" asp-route-id="@item.Id">

                        <div class="avatar" data-av="@Avatars.ColorIndex(item.Title)">
                            @if (item.IsGroup)
                            {
                                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-users" /></svg>
                            }
                            else
                            {
                                @Avatars.Initials(item.Title)
                            }
                        </div>

                        <div class="c-meta">
                            <b>
                                <span class="c-name">@item.Title</span>
                                <time>@item.LastAt.ToLocalTime().ToString("dd.MM HH:mm")</time>
                            </b>
                            <p>@item.Preview</p>
                        </div>

                        @if (item.Unread > 0)
                        {
                            <span class="unread">@item.Unread</span>
                        }
                    </a>
                }

                @if (Model.IsSearching)
                {
                    <div class="convo-found">Найдено в сообщениях: @Model.FoundMessages.Count</div>

                    @foreach (var hit in Model.FoundMessages)
                    {
                        var parts = Model.Highlight(hit.Excerpt);

                        <a class="convo hit" asp-page="Index" asp-route-id="@hit.ConversationId">
                            <div class="c-meta">
                                <b>
                                    <span class="c-name">@hit.ConversationTitle</span>
                                    <time>@hit.At.ToLocalTime().ToString("dd.MM HH:mm")</time>
                                </b>
                                <p>@parts.Before<mark>@parts.Match</mark>@parts.After</p>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>

        @* ---------- Справа: выбранная беседа ---------- *@
        <div class="chat-panel">
            @if (Model.Current is null)
            {
                <div class="empty chat-empty">
                    <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-chat" /></svg>
                    <b>Выберите переписку</b>
                    <p>Слева список, или нажмите «Написать», чтобы начать новую</p>
                </div>
            }
            else
            {
                <div class="chat-head">
                    <div class="avatar" data-av="@Avatars.ColorIndex(Model.Title)">
                        @if (Model.Current.IsGroup)
                        {
                            <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-users" /></svg>
                        }
                        else
                        {
                            @Avatars.Initials(Model.Title)
                        }
                    </div>

                    <div class="ch-meta">
                        <b>@Model.Title</b>
                        <span>
                            @if (Model.Current.IsGroup)
                            {
                                @($"Участников: {Model.Current.Participants.Count}")
                            }
                            else
                            {
                                @:личная переписка
                            }
                        </span>
                    </div>

                    @if (Model.Current.IsGroup)
                    {
                        <button class="btn sm" type="button" id="groupBtn">
                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-users" /></svg>Участники
                        </button>
                    }
                </div>

                @* Состав группы. Виден не глазом, а коду страницы: окно
                   «Участники» строится из этих строк и не ходит на сервер
                   второй раз за тем, что уже пришло вместе со страницей. *@
                @if (Model.Current.IsGroup)
                {
                    <div hidden>
                        @foreach (var person in Model.Current.Participants.OrderByDescending(p => p.IsOwner).ThenBy(p => p.DisplayName))
                        {
                            <span data-participant="@person.UserName"
                                  data-name="@(string.IsNullOrWhiteSpace(person.DisplayName) ? person.UserName : person.DisplayName)"
                                  data-owner="@person.IsOwner.ToString().ToLowerInvariant()"></span>
                        }
                    </div>
                }

                @if (Model.IsOutsideObserver)
                {
                    <div class="alert warn chat-note" role="status">
                        Вы смотрите эту переписку как администратор портала. Писать в неё нельзя.
                    </div>
                }

                <div class="msgs" id="msgs">
                    @if (Model.Items.Count == 0)
                    {
                        <div class="msg sys"><div class="bubble">Сообщений пока нет. Напишите первое.</div></div>
                    }

                    @* День отбивается один раз — там, где он меняется.
                       Под сообщением стоит только время, и без такой отбивки
                       вчерашнее «14:20» ничем не отличается от сегодняшнего. *@
                    @{
                        var today = DateTime.Now.Date;
                        var lastDay = default(DateTime?);
                    }

                    @foreach (var message in Model.Items)
                    {
                        var mine = string.Equals(message.AuthorUserName, Model.UserName,
                            StringComparison.OrdinalIgnoreCase);

                        var at = message.CreatedAt.ToLocalTime();

                        if (lastDay != at.Date)
                        {
                            lastDay = at.Date;

                            <div class="day-sep"><span>@Portal.Web.Pages.Messages.IndexModel.DayLabel(at.Date, today)</span></div>
                        }

                        <div class="msg@(mine ? " mine" : "")" data-message="@message.Id">
                            @if (!mine)
                            {
                                <div class="avatar" data-av="@Avatars.ColorIndex(message.AuthorDisplayName)">@Avatars.Initials(message.AuthorDisplayName)</div>
                            }

                            <div class="bubble">
                                @if (!mine && Model.Current.IsGroup)
                                {
                                    <div class="b-name">@message.AuthorDisplayName</div>
                                }

                                @if (message.DeletedAt is not null)
                                {
                                    <div class="b-text b-deleted">сообщение удалено</div>
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(message.Body))
                                    {
                                        @* Текст выводится как текст: Razor кодирует его сам,
                                           и разметка из сообщения на страницу не попадёт.
                                           Переносы строк сохраняет стиль white-space. *@
                                        <div class="b-text">@message.Body</div>
                                    }

                                    @foreach (var file in message.Files.Where(f => f.PurgedAt is null))
                                    {
                                        <a class="b-file"
                                           asp-page="Index" asp-page-handler="Attachment" asp-route-fileId="@file.Id">
                                            @FileIcons.File(file.OriginalName, 20)
                                            <span class="b-fname">@file.OriginalName</span>
                                            <span class="b-fsize">@Portal.Web.Pages.Messages.IndexModel.FormatSize(file.SizeBytes)</span>
                                        </a>
                                    }
                                }

                                @* В подсказке — полные дата и время: разделитель
                                   дня отвечает на вопрос «когда» для всей пачки
                                   сообщений, а здесь его можно уточнить по одному. *@
                                <div class="b-time" title="@at.ToString("dd.MM.yyyy HH:mm")">
                                    @at.ToString("HH:mm")

                                    @if (message.DeletedAt is null && (mine || Model.IsOutsideObserver))
                                    {
                                        <button class="b-del" type="button"
                                                data-delete-message="@message.Id" title="Удалить сообщение">
                                            <svg class="ic" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trash" /></svg>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.CanWrite)
                {
                    <form class="chat-input" method="post" asp-page-handler="Send" asp-route-id="@Model.Current.Id"
                          enctype="multipart/form-data" id="chatForm">

                        <button class="icon-btn" type="button" id="attachBtn" title="Приложить файл">
                            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-clip" /></svg>
                        </button>

                        <input type="file" name="attachments" id="chatFiles" multiple hidden />

                        <textarea asp-for="Body" rows="1" maxlength="8000" id="chatText"
                                  placeholder="Сообщение… Enter — отправить, Shift+Enter — новая строка"></textarea>

                        <button class="send-btn" type="submit" title="Отправить">
                            <svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-send" /></svg>
                        </button>
                    </form>

                    <div class="chat-attached" id="chatAttached" hidden></div>
                }
            }
        </div>
    </div>

    @* Скрытая форма нужна ради antiforgery-токена: из неё его берёт
       код страницы для всех действий, которые меняют данные. *@
    <form method="post" asp-page-handler="Start" hidden></form>
</section>
