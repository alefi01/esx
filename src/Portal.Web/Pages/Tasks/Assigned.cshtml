@page
@using Portal.Web.Data
@model Portal.Web.Pages.Tasks.AssignedModel
@{
    ViewData["Title"] = "Задачи подчинённым";
}

@*
    Страница того, кто ставит задачи: что он поручил, кто что сдал
    и что ждёт его проверки.

    Данные для кода страницы передаются data-атрибутами, а не вставленным
    <script>: политика безопасности запрещает встроенные скрипты.
*@
<section class="view active tasks-page" data-assigned-tasks>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <span data-flash="@Model.StatusMessage" data-flash-kind="ok" hidden></span>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <span data-flash="@Model.ErrorMessage" data-flash-kind="danger" hidden></span>
    }

    <div class="view-head">
        @* Заголовок тот же, что и у своих задач: это один раздел.
           Какая половина открыта — видно по вкладке. *@
        <h2>Задачи</h2>

        @{
            var tabs = new Portal.Web.Pages.Shared.TasksTabs(
                "assigned", Model.MineAttention, Model.WaitingCount, Model.HasHead);
        }

        <partial name="_TasksTabs" model="tabs" />

        <nav class="seg seg--sub" aria-label="Какие задачи показывать">
            <a class="seg-btn@(Model.ViewMode == "active" ? " on" : "")" asp-page="Assigned">
                В работе
                @if (Model.WaitingCount > 0)
                {
                    <span class="side-count">@Model.WaitingCount</span>
                }
            </a>
            <a class="seg-btn@(Model.ViewMode == "done" ? " on" : "")" asp-page="Assigned" asp-route-view="done">
                <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>Выполненные
            </a>
        </nav>

        @* Кнопка стоит в заголовке, а не отдельной карточкой над списком:
           карточка ради одной кнопки занимала целую полосу экрана
           и отодвигала вниз то, ради чего на страницу заходят.

           Видна она и на «Выполненных»: поставить задачу можно
           и оттуда, а прятать кнопку — значит заставлять сначала
           переключиться обратно. *@
        <button class="btn primary" type="button" id="newAssignedBtn">
            <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-plus" /></svg>Новая задача
        </button>
    </div>

    @* ---------- Новая задача ----------

       Форма лежит здесь спрятанной, а показывается в окне поверх
       страницы: полей у поручения много (срок, повторение, признаки),
       и развёрнутыми в списке они отодвигали вниз сам список, ради
       которого на страницу и заходят.

       Форма при этом настоящая и остаётся на странице: окно её
       переносит, а не пересобирает. Поэтому работают и проверка
       на сервере, и загрузка файла, и защита от подделки запроса —
       всё то, что пришлось бы повторять, рисуй мы окно кодом. *@
    <div id="newAssignedHolder" hidden>
            <form method="post" asp-page-handler="Create" enctype="multipart/form-data"
                  id="newAssignedForm" class="assigned-form">

                <div asp-validation-summary="ModelOnly" class="alert err"></div>

                <div class="field">
                    <label asp-for="Input.Assignee">Кому</label>

                    @* Человек выбирается подсказкой прямо в поле, а логин
                       уходит скрытым: набирать логин руками — верный способ
                       поставить задачу не тому.

                       Раньше для выбора открывалось второе окно. Но форма
                       сама теперь живёт в окне, а второе окно закрывает
                       первое — вместе с набранным текстом. Подсказка
                       в поле короче на два нажатия и ничего не закрывает. *@
                    @* Выбранные стоят плашками над полем: одну задачу
                       часто ставят нескольким, и список имён строкой
                       быстро перестаёт читаться — не видно, кого уже
                       выбрали и кого можно убрать. *@
                    <div class="chips" id="assigneeChips" data-chosen="@Model.ChosenJson"></div>

                    <div class="pick" data-pick>
                        <input type="text" id="assigneeName" autocomplete="off"
                               placeholder="Фамилия или логин" value="" />

                        <div class="pick-list" id="assigneeList" hidden></div>
                    </div>

                    <p class="hint">Можно выбрать нескольких. Щелчок по имени
                       поручает приёмку работы этому исполнителю — иначе
                       принимаете вы.</p>

                    <input type="hidden" asp-for="Input.Assignee" id="assigneeLogin" />
                    <input type="hidden" asp-for="Input.Controller" id="controllerLogin" />
                    <span asp-validation-for="Input.Assignee" class="err"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Title">Что нужно сделать</label>
                    <input asp-for="Input.Title" maxlength="300" autocomplete="off" />
                    <span asp-validation-for="Input.Title" class="err"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Notes">Подробности</label>
                    <textarea asp-for="Input.Notes" rows="2" maxlength="4000"></textarea>
                </div>

                <div class="row-form">
                    <div class="field">
                        <label asp-for="Input.DueOn">Срок</label>

                        @* Обязательность проверяет браузер, не отправляя форму:
                           уход на сервер и обратно стирал выбранный файл —
                           вернуть его в поле не вправе никто, кроме человека. *@
                        <input asp-for="Input.DueOn" type="date" required />
                        <span asp-validation-for="Input.DueOn" class="err"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.DueTime">Время</label>
                        <input asp-for="Input.DueTime" type="time" />
                        <span class="hint">Пусто — конец дня</span>
                    </div>

                    <div class="field">
                        <label asp-for="Input.Repeat">Повторять</label>
                        <select asp-for="Input.Repeat" id="repeatSel">
                            <option value="@((int)TaskRepeat.Once)">не повторять</option>
                            <option value="@((int)TaskRepeat.Daily)">каждый день</option>
                            <option value="@((int)TaskRepeat.Weekdays)">по дням недели</option>
                            <option value="@((int)TaskRepeat.Weekly)">раз в неделю</option>
                            <option value="@((int)TaskRepeat.Monthly)">раз в месяц</option>
                        </select>
                    </div>

                    <div class="field">
                        <label asp-for="Input.RemindMinutes">Напомнить за, мин</label>
                        <input asp-for="Input.RemindMinutes" type="number" min="0" max="10080" />
                        <span class="hint">0 — не напоминать</span>
                    </div>
                </div>

                <div class="field" id="weekDaysField" hidden>
                    <label>Дни недели</label>
                    <div class="row-form">
                        @{
                            var dayNames = new[] { "пн", "вт", "ср", "чт", "пт", "сб", "вс" };
                        }
                        @for (var i = 0; i < dayNames.Length; i++)
                        {
                            <label class="fs-check">
                                <input type="checkbox" name="Input.WeekDays" value="@i" />
                                <span>@dayNames[i]</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="field" id="monthDayField" hidden>
                    <label asp-for="Input.MonthDay">Число месяца</label>
                    <input asp-for="Input.MonthDay" type="number" min="1" max="31" />
                    <span class="hint">29–31 в коротком месяце съезжают на последний день</span>
                </div>

                <div class="row-form">
                    <label class="fs-check">
                        <input asp-for="Input.NeedCheck" type="checkbox" />
                        <span>Нужна проверка</span>
                    </label>

                    <label class="fs-check">
                        <input asp-for="Input.NeedFile" type="checkbox" />
                        <span>Сдать с файлом</span>
                    </label>

                    <label class="fs-check">
                        <input asp-for="Input.Important" type="checkbox" />
                        <span>Важно</span>
                    </label>
                </div>

                <p class="hint">
                    «Нужна проверка» снята — исполнитель закрывает задачу сам кнопкой «Выполнено».
                    «Важно» — яркая пометка в списке, а на рабочем ПК с виджетом ещё и окно
                    поверх всех программ со звуком.
                </p>

                <div class="field">
                    <label for="taskFiles">Приложить файл</label>

                    <label class="file-pick">
                        <input type="file" name="attachments" id="taskFiles" multiple data-file-pick />
                        <span class="file-pick-btn">
                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-upload" /></svg>Выбрать файл
                        </span>
                        <span class="file-pick-name" data-file-name>не выбран</span>
                    </label>

                    <span class="hint">Бланк, образец, шаблон — то, по чему делать</span>
                </div>

                <div class="form-actions">
                    <button class="btn primary" type="submit">Поставить задачу</button>
                    <button class="btn" type="button" id="cancelAssigned">Отмена</button>
                </div>
        </form>
    </div>

    @* ---------- Правка задачи ----------

       Условия меняются: перенесли совещание, уточнили, что приложить.
       Раньше задачу приходилось снимать и ставить заново — и вместе
       с ней терялась вся история сдачи.

       Форма одна на страницу, а не по одной на карточку: правят по
       одной задаче за раз, а сотня скрытых форм — это сотня наборов
       полей в разметке на каждую загрузку.

       Исполнителей правка не трогает: сменить исполнителя посреди
       работы — это другая задача, и путать её с уточнением условий
       не стоит. *@
    <div id="editTaskHolder" hidden>
        <form method="post" asp-page-handler="Edit" id="editTaskForm" class="assigned-form">
            <input type="hidden" name="taskId" id="editTaskId" />
            <input type="hidden" name="view" value="@Model.View" />
            <input type="hidden" name="sort" value="@Model.Sort" />

            <div class="field">
                <label for="editTitle">Что нужно сделать</label>
                <input type="text" name="title" id="editTitle" maxlength="300" autocomplete="off" required />
            </div>

            <div class="field">
                <label for="editNotes">Подробности</label>
                <textarea name="notes" id="editNotes" rows="2" maxlength="4000"></textarea>
            </div>

            <div class="row-form">
                <div class="field">
                    <label for="editDue">Срок</label>
                    <input type="date" name="dueOn" id="editDue" />
                </div>

                <div class="field">
                    <label for="editTime">Время</label>
                    <input type="time" name="dueTime" id="editTime" />
                    <span class="hint">Пусто — конец дня</span>
                </div>
            </div>

            <div class="row-form">
                <label class="fs-check">
                    <input type="checkbox" name="needCheck" value="true" id="editCheck" />
                    <span>Нужна проверка</span>
                </label>

                <label class="fs-check">
                    <input type="checkbox" name="needFile" value="true" id="editFile" />
                    <span>Сдать с файлом</span>
                </label>

                <label class="fs-check">
                    <input type="checkbox" name="important" value="true" id="editImp" />
                    <span>Важно</span>
                </label>
            </div>

            <p class="hint">
                Исполнитель увидит отметку «отредактировано» и время —
                он мог прочитать задачу раньше и делать по старому тексту.
            </p>

            <div class="form-actions">
                <button class="btn primary" type="submit">Сохранить</button>
                <button class="btn" type="button" id="cancelEditTask">Отмена</button>
            </div>
        </form>
    </div>

    @if (Model.Items.Count > 0)
    {
        @* ---------- Доска ----------

           Столбец на каждое состояние: сразу видно, чьего действия
           ждёт задача — исполнителя, начальника или снова исполнителя.
           Пустые столбцы остаются на месте: доска, у которой при каждом
           движении меняется число колонок, перестаёт читаться
           с одного взгляда. *@
        <div class="tboard">
            @foreach (var column in Model.Columns)
            {
                <section class="tcol tcol--@column.Key">
                    <header class="tcol-head">
                        <span class="tcol-name">@column.Title</span>

                        @* Порядок карточек. Кнопка проявляется при наведении
                           на столбец: нужна она изредка, а висеть на виду
                           в каждом столбце — значит отвлекать постоянно.
                           Выбранный порядок виден всегда: он общий
                           для доски, и человек должен понимать, почему
                           карточки лежат именно так. *@
                        <a class="tcol-sort@(Model.ImportantFirst ? " on" : "")"
                           asp-page="Assigned" asp-route-view="@Model.View"
                           asp-route-sort="@(Model.ImportantFirst ? null : "important")"
                           title="@(Model.ImportantFirst ? "Сейчас: важные сверху. Вернуть порядок по сроку" : "Поднять важные наверх")">
                            <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-sort" /></svg>
                        </a>

                        <span class="tcol-count">@column.Cards.Count</span>
                    </header>

                    <div class="tcol-body">
                        @foreach (var card in column.Cards)
                        {
                            var item = card.Instance;
                            var task = card.Task;

                            @* Исполнитель берётся у ЭКЗЕМПЛЯРА: у задачи
                               их может быть несколько, и каждая карточка
                               на доске — чья-то конкретная работа.
                               У задач, заведённых до появления нескольких
                               исполнителей, поле пустое — для них смотрим
                               на саму задачу. *@
                            var who = string.IsNullOrEmpty(item.AssigneeDisplayName)
                                ? task.AssigneeDisplayName
                                : item.AssigneeDisplayName;

                            var controls = task.Assignees.Any(a => a.IsController
                                && string.Equals(a.UserName, item.AssigneeUserName, StringComparison.OrdinalIgnoreCase));

                            var mine = string.Equals(task.AuthorUserName, Model.Me, StringComparison.OrdinalIgnoreCase);

                            var urgency = card.Urgency switch
                            {
                                Portal.Web.Services.Tasks.TaskUrgency.Now => " urgent-now",
                                Portal.Web.Services.Tasks.TaskUrgency.Close => " urgent-close",
                                Portal.Web.Services.Tasks.TaskUrgency.Soon => " urgent-soon",
                                _ => ""
                            };

                            <article class="bcard@(card.Overdue ? " overdue" : "")@urgency">
                                @if (task.Important || item is { State: TaskState.Open, TakenAt: null })
                                {
                                    @* Метки — над названием: в одной строке
                                       с ним они отъедали половину ширины,
                                       и заголовок переносился по слову. *@
                                    <div class="bcard-flags">
                                        @if (task.Important)
                                        {
                                            <span class="t-imp" title="Важная задача">
                                                <svg class="ic" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-alert" /></svg>Важно
                                            </span>
                                        }

                                        @if (item is { State: TaskState.Open, TakenAt: null })
                                        {
                                            @* Ответ на вопрос «он её вообще видел?».
                                               До сих пор его выясняли в переписке. *@
                                            <span class="task-state state-fresh">не взята в работу</span>
                                        }
                                    </div>
                                }

                                <b class="bcard-title">@task.Title</b>

                                @if (!string.IsNullOrWhiteSpace(task.Notes))
                                {
                                    <p class="bcard-notes">@task.Notes</p>
                                }

                                <div class="task-meta-row">
                                    <span class="t-when@(card.Overdue ? " late" : "")@urgency">
                                        <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-clock" /></svg>@Portal.Web.Pages.Tasks.IndexModel.DueText(item.DueAt, task.DueMinutes is not null)
                                    </span>

                                    @if (task.Repeat != TaskRepeat.Once)
                                    {
                                        <span class="t-dot-sep"></span>

                                        <span class="t-rep">
                                            <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-restore" /></svg>@Portal.Web.Pages.Tasks.AssignedTaskText.RepeatFor(task)
                                        </span>
                                    }

                                </div>

                                @* Файлы ссылками, а не числом: начальник
                                   открывает карточку именно затем, чтобы
                                   посмотреть, что ему сдали. Число отвечало
                                   «файл есть», но взять его было негде. *@
                                @if (task.Files.Count + item.Files.Count > 0)
                                {
                                    <div class="task-files">
                                        @foreach (var file in task.Files.Concat(item.Files))
                                        {
                                            <a class="chip" asp-page-handler="File" asp-route-fileId="@file.Id">
                                                <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-file" /></svg>@file.OriginalName
                                            </a>
                                        }
                                    </div>
                                }

                                @if (task.EditedAt is { } edited)
                                {
                                    @* То же, что в переписке: исполнитель мог
                                       прочитать задачу вчера и делать по тому,
                                       что прочитал. Молча подменённый текст
                                       хуже отсутствия правки вовсе. *@
                                    <p class="bcard-edited">отредактировано @edited.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                                }

                                <footer class="bcard-foot">
                                    <span class="task-who-ava" title="@who">@Portal.Web.Pages.Shared.Avatars.Initials(who)</span>
                                    <span class="bcard-who">@who</span>

                                    @if (controls)
                                    {
                                        <span class="t-ctrl" title="Этот исполнитель принимает работу">контроль</span>
                                    }

                                    @if (mine && !item.IsClosed)
                                    {
                                        @* Иконкой, а не словом: подвал карточки узкий,
                                           и текстовая кнопка съедает имя исполнителя. *@
                                        <button class="icon-btn" type="button" title="Изменить"
                                                data-edit-task="@task.Id"
                                                data-title="@task.Title"
                                                data-notes="@task.Notes"
                                                data-due="@(item.DueAt.ToLocalTime().ToString("yyyy-MM-dd"))"
                                                data-time="@(task.DueMinutes is { } m ? new TimeOnly(m / 60, m % 60).ToString("HH\\:mm") : "")"
                                                data-file="@(task.NeedFile ? "1" : "")"
                                                data-check="@(task.NeedCheck ? "1" : "")"
                                                data-imp="@(task.Important ? "1" : "")">
                                            <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-edit" /></svg>
                                        </button>
                                    }

                                    @if (item.State == TaskState.Submitted)
                                    {
                                        <form method="post" asp-page-handler="Accept" asp-route-instanceId="@item.Id"
                                              asp-route-view="@Model.View" asp-route-sort="@Model.Sort" class="head-form">
                                            <button class="btn primary sm" type="submit">Принять</button>
                                        </form>

                                        <button class="btn sm" type="button"
                                                data-return-task="@item.Id" data-task-title="@task.Title">
                                            Вернуть
                                        </button>
                                    }
                                </footer>
                            </article>
                        }

                        @if (column.Cards.Count == 0)
                        {
                            <p class="tcol-empty">пусто</p>
                        }
                    </div>
                </section>
            }
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="empty">
            <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-users" /></svg>
            @if (Model.ViewMode == "done")
            {
                <b>Закрытых задач нет</b>
            }
            else
            {
                <b>Задач нет</b>
            }
        </div>
    }
    else
    {
        <div class="task-list">
            @foreach (var card in Model.Items)
            {
                var item = card.Instance;
                var task = card.Task;

                var urgency = card.Urgency switch
                {
                    Portal.Web.Services.Tasks.TaskUrgency.Now => " urgent-now",
                    Portal.Web.Services.Tasks.TaskUrgency.Close => " urgent-close",
                    Portal.Web.Services.Tasks.TaskUrgency.Soon => " urgent-soon",
                    _ => ""
                };

                <div class="task-card@(item.IsClosed ? " done" : "")@(card.Overdue ? " overdue" : "")@urgency@(task.Important ? " important" : "")">
                    <div class="task-body">
                        @* Кому поручено — кружком слева от названия:
                           этот список читают по людям, а не по названиям
                           задач, и человек должен находиться взглядом
                           до того, как прочитано хоть одно слово. *@
                        <div class="task-title-row">
                            <span class="task-who-ava" title="@task.AssigneeDisplayName">@Portal.Web.Pages.Shared.Avatars.Initials(task.AssigneeDisplayName)</span>

                            @if (task.Important)
                            {
                                <span class="t-imp" title="Важная задача">
                                    <svg class="ic" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-alert" /></svg>Важно
                                </span>
                            }

                            <b>@task.Title</b>

                            <span class="task-state state-@item.State.ToString().ToLowerInvariant()">
                                @Portal.Web.Pages.Tasks.AssignedTaskText.StateFor(item.State)
                            </span>
                        </div>

                        <div class="task-meta-row">
                            <span class="t-from">@task.AssigneeDisplayName</span>

                            <span class="t-dot-sep"></span>

                            <span class="t-when@(card.Overdue ? " late" : "")@urgency">
                                <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-clock" /></svg>@Portal.Web.Pages.Tasks.IndexModel.DueText(item.DueAt, task.DueMinutes is not null)
                            </span>

                            @if (task.Repeat != TaskRepeat.Once)
                            {
                                <span class="t-dot-sep"></span>

                                <span class="t-rep">
                                    <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-restore" /></svg>@Portal.Web.Pages.Tasks.AssignedTaskText.RepeatFor(task)
                                </span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(task.Notes))
                        {
                            <p class="task-notes-text">@task.Notes</p>
                        }

                        @if (item.Returns > 0)
                        {
                            <p class="task-return">
                                Возвращалась @item.Returns @Portal.Web.Pages.Shared.Plural.Of(item.Returns, "раз", "раза", "раз")
                            </p>
                        }

                        @if (task.Files.Count > 0 || item.Files.Count > 0)
                        {
                            <div class="task-files">
                                @foreach (var file in task.Files.Concat(item.Files))
                                {
                                    <a class="chip" asp-page-handler="File" asp-route-fileId="@file.Id">
                                        @file.OriginalName
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    <div class="task-tools">
                        @if (item.State == TaskState.Submitted)
                        {
                            <form method="post" asp-page-handler="Accept" asp-route-instanceId="@item.Id"
                                  asp-route-view="@Model.View" asp-route-sort="@Model.Sort" class="head-form">
                                <button class="btn primary sm" type="submit">Принять</button>
                            </form>

                            <button class="btn sm" type="button"
                                    data-return-task="@item.Id" data-task-title="@task.Title">
                                Вернуть
                            </button>
                        }

                        @if (!item.IsClosed)
                        {
                            <form method="post" asp-page-handler="Cancel" asp-route-instanceId="@item.Id"
                                  asp-route-view="@Model.View" asp-route-sort="@Model.Sort" class="head-form">
                                <button class="btn sm" type="submit" data-confirm-action
                                        data-confirm-text="Снять задачу «@task.Title» на этот раз? Повторение, если оно есть, продолжится."
                                        data-confirm-ok="Снять">
                                    Снять на этот раз
                                </button>
                            </form>

                            @if (task.Repeat != TaskRepeat.Once && !task.Stopped)
                            {
                                <form method="post" asp-page-handler="Stop" asp-route-taskId="@task.Id"
                                      asp-route-view="@Model.View" asp-route-sort="@Model.Sort" class="head-form">
                                    <button class="btn sm danger" type="submit" data-confirm-action
                                            data-confirm-text="Прекратить задачу «@task.Title»? Новых сроков больше не будет, история останется."
                                            data-confirm-ok="Прекратить">
                                        Прекратить
                                    </button>
                                </form>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Скрытая форма ради antiforgery-токена: из неё его берёт код страницы
       для окна возврата на доработку. *@
    <form method="post" asp-page-handler="Return" hidden></form>
</section>
