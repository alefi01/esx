@page
@model Portal.Web.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = Model.FromHeadView ? "Задачи от руководителя" : "Мои задачи";
}

@*
    «Задачи» глазами того, кто их выполняет. Две половины раздела
    на одной странице: свои заметки и поручения руководителя.

    Разделены они намеренно — у них разные правила. Своя заметка
    закрывается галочкой и убирается в архив; поручение сдают, и его
    закрывает тот, кто поставил. Карточки в одном списке, которые
    ведут себя по-разному, — верный способ научить людей не доверять
    ни одной.
*@
<section class="view active tasks-page">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <span data-flash="@Model.StatusMessage" data-flash-kind="ok" hidden></span>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <span data-flash="@Model.ErrorMessage" data-flash-kind="danger" hidden></span>
    }

    <div class="view-head">
        <h2>Задачи</h2>

        @{
            var tabs = new Portal.Web.Pages.Shared.TasksTabs(
                Model.FromHeadView ? "head" : "own", Model.HeadCount, Model.WaitingCount, Model.HasHead);
        }

        <partial name="_TasksTabs" model="tabs" />

        <nav class="seg seg--sub" aria-label="Какие задачи показывать">
            <a class="seg-btn@(Model.ViewMode == "active" ? " on" : "")"
               asp-page="Index" asp-route-scope="@Model.Scope">
                В работе
                @if (!Model.FromHeadView && Model.ActiveCount > 0)
                {
                    <span class="side-count">@Model.ActiveCount</span>
                }
            </a>
            <a class="seg-btn@(Model.ViewMode == "done" ? " on" : "")"
               asp-page="Index" asp-route-scope="@Model.Scope" asp-route-view="done">
                <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>Выполненные
            </a>
        </nav>

        @* Своя задача ставится в окне — тем же, что и задача
           подчинённому. Кнопка не пропадает на вкладке «Выполненные»:
           записать дело можно и оттуда, и прятать кнопку — значит
           заставлять сначала переключиться. *@
        @if (!Model.FromHeadView)
        {
            <button class="btn primary" type="button" id="newOwnBtn">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-plus" /></svg>Новая задача
            </button>
        }
    </div>

    @if (!Model.FromHeadView)
    {
        <div id="newOwnHolder" hidden>
            <form method="post" asp-page-handler="Create" class="assigned-form" id="newOwnForm">
                <div asp-validation-summary="ModelOnly" class="alert err"></div>

                <div class="field">
                    <label asp-for="Input.Title">Что нужно сделать</label>
                    <input asp-for="Input.Title" maxlength="300" autocomplete="off" />
                    <span asp-validation-for="Input.Title" class="err"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.Notes">Подробности</label>
                    <textarea asp-for="Input.Notes" rows="3" maxlength="4000"></textarea>
                </div>

                <div class="row-form">
                    <div class="field">
                        <label asp-for="Input.DueOn">Срок</label>
                        <input asp-for="Input.DueOn" type="date" />
                        <span class="hint">Необязательно</span>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn primary" type="submit">Добавить</button>
                    <button class="btn" type="button" id="cancelOwn">Отмена</button>
                </div>
            </form>
        </div>
    }

    @{
        var empty = Model.FromHeadView ? Model.FromHead.Count == 0 : Model.Items.Count == 0;
    }

    @if (empty)
    {
        <div class="empty">
            <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check-square" /></svg>
            @if (Model.ViewMode == "done")
            {
                <b>Выполненных пока нет</b>
            }
            else
            {
                <b>Задач нет</b>
            }
        </div>
    }
    else
    {
        <div class="tboard">
            @foreach (var column in Model.Columns)
            {
                <section class="tcol tcol--@column.Key">
                    <header class="tcol-head">
                        <span class="tcol-name">@column.Title</span>
                        <span class="tcol-count">@column.Count</span>
                    </header>

                    <div class="tcol-body">

                        @* ---------- Поручения руководителя ---------- *@
                        @foreach (var card in column.Head)
                        {
                            var item = card.Instance;
                            var task = card.Task;

                            var urgency = card.Urgency switch
                            {
                                Portal.Web.Services.Tasks.TaskUrgency.Now => " urgent-now",
                                Portal.Web.Services.Tasks.TaskUrgency.Close => " urgent-close",
                                Portal.Web.Services.Tasks.TaskUrgency.Soon => " urgent-soon",
                                _ => ""
                            };

                            <article class="bcard from-head@(card.Overdue ? " overdue" : "")@urgency">
                                <div class="bcard-top">
                                    @if (task.Important)
                                    {
                                        <span class="t-imp" title="Важная задача">
                                            <svg class="ic" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-alert" /></svg>
                                        </span>
                                    }

                                    <b>@task.Title</b>

                                    <span class="task-state state-@(item is { State: Portal.Web.Data.TaskState.Open, TakenAt: null } ? "fresh" : item.State.ToString().ToLowerInvariant())">
                                        @Portal.Web.Pages.Tasks.AssignedTaskText.StateFor(item)
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(task.Notes))
                                {
                                    <p class="bcard-notes">@task.Notes</p>
                                }

                                <div class="task-meta-row">
                                    <span class="t-when@(card.Overdue ? " late" : "")@urgency">
                                        <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-clock" /></svg>@Portal.Web.Pages.Tasks.IndexModel.DueText(item.DueAt, task.DueMinutes is not null)
                                    </span>

                                    <span class="t-dot-sep"></span>

                                    <span class="t-from">@task.AuthorDisplayName</span>
                                </div>

                                @if (item.State == Portal.Web.Data.TaskState.Returned && item.ReturnReason is { } reason)
                                {
                                    <p class="task-return">
                                        <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-restore" /></svg>
                                        Возвращено: @reason
                                    </p>
                                }

                                @* Файлы: сначала приложенное автором (бланк,
                                   образец), потом сданное. *@
                                @if (task.Files.Count > 0 || item.Files.Count > 0)
                                {
                                    <div class="task-files">
                                        @foreach (var file in task.Files.Concat(item.Files))
                                        {
                                            <a class="chip" asp-page-handler="File" asp-route-fileId="@file.Id">
                                                @file.OriginalName
                                            </a>
                                        }
                                    </div>
                                }

                                @* Отметка «взял в работу»: до неё задача лежит
                                   в столбце «Новые». Сдать можно и не беря —
                                   отметка это сведения, а не пропуск: ставить
                                   лишний шаг перед работой, сделанной за минуту,
                                   было бы издевательством. *@
                                @if (item is { IsClosed: false, TakenAt: null, State: Portal.Web.Data.TaskState.Open })
                                {
                                    <form method="post" asp-page-handler="Take" asp-route-instanceId="@item.Id"
                                          asp-route-scope="@Model.Scope" asp-route-view="@Model.View" class="head-form">
                                        <button class="btn sm" type="submit">
                                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>Взять в работу
                                        </button>
                                    </form>
                                }

                                @if (!item.IsClosed && item.State != Portal.Web.Data.TaskState.Submitted)
                                {
                                    <form method="post" asp-page-handler="Submit" asp-route-instanceId="@item.Id"
                                          asp-route-scope="@Model.Scope" asp-route-view="@Model.View"
                                          enctype="multipart/form-data" class="task-submit">

                                        <label class="file-pick">
                                            <input type="file" name="attachments" multiple
                                                   aria-label="Файл к задаче" data-file-pick />
                                            <span class="file-pick-btn">
                                                <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-upload" /></svg>Файл
                                            </span>
                                            <span class="file-pick-name" data-file-name>не выбран</span>
                                        </label>

                                        <button class="btn primary sm" type="submit">
                                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>@(task.NeedCheck ? "Сдать" : "Выполнено")
                                        </button>

                                        @if (task.NeedFile)
                                        {
                                            <span class="hint">Нужен файл</span>
                                        }
                                    </form>
                                }
                            </article>
                        }

                        @* ---------- Свои заметки ---------- *@
                        @foreach (var card in column.Own)
                        {
                            var task = card.Task;

                            var urgency = card.Urgency switch
                            {
                                Portal.Web.Services.Tasks.TaskUrgency.Now => " urgent-now",
                                Portal.Web.Services.Tasks.TaskUrgency.Close => " urgent-close",
                                Portal.Web.Services.Tasks.TaskUrgency.Soon => " urgent-soon",
                                _ => ""
                            };

                            <article class="bcard@(task.IsDone ? " done" : "")@(card.Overdue ? " overdue" : "")@urgency">
                                <div class="bcard-top">
                                    @* Галочка — форма, а не кнопка с кодом: так она
                                       работает и без JavaScript, а права проверяет
                                       сервер, а не разметка. *@
                                    @if (card.Mine)
                                    {
                                        <form method="post" asp-page-handler="Done" asp-route-id="@task.Id"
                                              asp-route-scope="@Model.Scope" asp-route-view="@Model.View"
                                              class="task-check-form">
                                            <button class="task-check@(task.IsDone ? " on" : "")" type="submit"
                                                    title="@(task.IsDone ? "Вернуть в работу" : "Отметить выполненной")">
                                                <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="task-check@(task.IsDone ? " on" : "") locked" title="Чужая задача — отмечает её хозяин">
                                            <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>
                                        </span>
                                    }

                                    <b>@task.Title</b>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(task.Notes))
                                {
                                    <p class="bcard-notes">@task.Notes</p>
                                }

                                @if (task.DueOn is not null || !card.Mine)
                                {
                                    <div class="task-meta-row">
                                        @if (task.DueOn is { } due)
                                        {
                                            <span class="t-when@(card.Overdue ? " late" : "")@urgency">
                                                <svg class="ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-clock" /></svg>@Portal.Web.Pages.Tasks.IndexModel.DueText(due)
                                            </span>
                                        }

                                        @if (!card.Mine)
                                        {
                                            @if (task.DueOn is not null)
                                            {
                                                <span class="t-dot-sep"></span>
                                            }

                                            <span class="t-from">@task.OwnerDisplayName</span>
                                        }
                                    </div>
                                }

                                @if (task.Shares.Count > 0)
                                {
                                    <div class="task-shared">
                                        <span class="hint">Видят:</span>
                                        @foreach (var share in task.Shares)
                                        {
                                            <span class="chip">
                                                @share.DisplayName
                                                @if (card.Mine)
                                                {
                                                    <button class="chip-x" type="submit" form="unshare-@task.Id-@share.Id"
                                                            title="Убрать из списка">×</button>
                                                }
                                            </span>

                                            @if (card.Mine)
                                            {
                                                @* Форма вынесена из разметки фишки: кнопка внутри
                                                   формы внутри формы — недопустимая разметка. *@
                                                <form method="post" asp-page-handler="Unshare" asp-route-id="@task.Id"
                                                      asp-route-scope="@Model.Scope" asp-route-view="@Model.View"
                                                      id="unshare-@task.Id-@share.Id" hidden>
                                                    <input type="hidden" name="login" value="@share.UserName" />
                                                </form>
                                            }
                                        }
                                    </div>
                                }

                                @if (task.EditedAt is { } edited)
                                {
                                    @* То же, что в переписке: задачу могли
                                       показать коллеге, и тот должен видеть,
                                       что текст с тех пор менялся. *@
                                    <p class="t-edited">отредактировано @edited.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                                }

                                @if (card.Mine)
                                {
                                    <footer class="bcard-foot bcard-tools">
                                        <button class="icon-btn" type="button" title="Изменить"
                                                data-edit-own="@task.Id"
                                                data-title="@task.Title"
                                                data-notes="@task.Notes"
                                                data-due="@(task.DueOn?.ToString("yyyy-MM-dd"))">
                                            <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-edit" /></svg>
                                        </button>

                                        <button class="icon-btn" type="button" title="Показать коллеге"
                                                data-share-task="@task.Id" data-task-title="@task.Title">
                                            <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-users" /></svg>
                                        </button>

                                        <form method="post" asp-page-handler="Archive" asp-route-id="@task.Id"
                                              asp-route-scope="@Model.Scope" asp-route-view="@Model.View" class="head-form">
                                            <button class="icon-btn" type="submit"
                                                    title="@(task.IsArchived ? "Вернуть из архива" : "Убрать в архив")">
                                                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="@(task.IsArchived ? "#i-restore" : "#i-archive")" /></svg>
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id"
                                              asp-route-scope="@Model.Scope" asp-route-view="@Model.View" class="head-form">
                                            <button class="icon-btn del" type="submit" data-confirm-action
                                                    data-confirm-text="Удалить задачу «@task.Title»? Восстановить её будет нельзя."
                                                    data-confirm-ok="Удалить"
                                                    title="Удалить">
                                                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trash" /></svg>
                                            </button>
                                        </form>
                                    </footer>
                                }
                            </article>
                        }

                        @if (column.Count == 0)
                        {
                            <p class="tcol-empty">пусто</p>
                        }
                    </div>
                </section>
            }
        </div>
    }

    @* ---------- Правка своей задачи ----------

       Форма одна на страницу: правят по одной задаче за раз, а по
       одной форме на карточку — это сотня наборов полей в разметке
       на каждую загрузку. *@
    <div id="editOwnHolder" hidden>
        <form method="post" asp-page-handler="Edit" id="editOwnForm" class="assigned-form">
            <input type="hidden" name="id" id="editOwnId" />
            <input type="hidden" name="scope" value="@Model.Scope" />
            <input type="hidden" name="view" value="@Model.View" />

            <div class="field">
                <label for="editOwnTitle">Что нужно сделать</label>
                <input type="text" name="title" id="editOwnTitle" maxlength="300" autocomplete="off" required />
            </div>

            <div class="field">
                <label for="editOwnNotes">Подробности</label>
                <textarea name="notes" id="editOwnNotes" rows="2" maxlength="4000"></textarea>
            </div>

            <div class="field">
                <label for="editOwnDue">Срок</label>
                <input type="date" name="dueOn" id="editOwnDue" />
            </div>

            <div class="form-actions">
                <button class="btn primary" type="submit">Сохранить</button>
                <button class="btn" type="button" id="cancelEditOwn">Отмена</button>
            </div>
        </form>
    </div>

    @* Скрытая форма для окна «показать коллеге»: из неё код страницы
       берёт antiforgery-токен. *@
    <form method="post" asp-page-handler="Share" hidden></form>
</section>
