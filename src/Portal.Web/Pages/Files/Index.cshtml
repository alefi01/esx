@page
@using Portal.Web.Data
@using Portal.Web.Pages.Shared
@model Portal.Web.Pages.Files.IndexModel
@{
    ViewData["Title"] = Model.Current is null ? "Файлы" : Model.Current.Name;

    var canWrite = Model.Current is not null && Model.Access >= FolderAccess.Write;

    // Права на ТЕКУЩУЮ папку. Для папок в списке права считаются отдельно,
    // по каждой своей (Model.CanManageFolder) — на верхнем уровне текущей
    // папки нет, и одно общее значение здесь давало бы ложный ответ.
    var canManageCurrent = Model.Current is not null && Model.Access >= FolderAccess.Manage;

    @* В самой папке отдела папок не заводят: в нём ровно две части,
       и смысл отдела в том, что у каждой свой понятный круг читателей.
       Третья папка рядом с ними сразу ставит вопрос «а эту кто видит?».
       Администратору кнопку оставляем — ему чинить последствия, если
       отдел завели не так. *@
    var canCreateFolder = Model.Current is null
        ? Model.IsAdmin
        : canWrite && (!Model.Current.IsDepartment || Model.IsAdmin);

    var empty = Model.IsSearching
        ? Model.FoundCount == 0
        : Model.Subfolders.Count == 0 && Model.FilesInFolder.Count == 0;
}

<section class="view active">

    @* Сообщения от сервера показываются всплывающим окошком, а не строкой
       в разметке: так же, как и все остальные отклики портала. *@
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <span data-flash="@Model.StatusMessage" data-flash-kind="ok" hidden></span>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <span data-flash="@Model.ErrorMessage" data-flash-kind="danger" hidden></span>
    }

    @if (!Model.StorageConfigured)
    {
        <div class="alert err" role="alert">
            <strong>Хранилище не настроено.</strong>
            Не задан путь <code>Storage:RootPath</code>, загрузка и скачивание работать не будут.
        </div>
    }

    @* ---------- Верхняя панель ---------- *@
    <div class="toolbar">
        @if (Model.Current is not null)
        {
            <a class="icon-btn back-btn" title="Назад" aria-label="Назад"
               asp-page="Index" asp-route-id="@Model.Current.ParentId">
                <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-back" /></svg>
            </a>
        }

        <nav class="crumbs" aria-label="Путь">
            <a class="crumb@(Model.Current is null ? " last" : "")" asp-page="Index">
                <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-home" /></svg>Файлы
            </a>
            @foreach (var crumb in Model.Breadcrumbs)
            {
                <span class="crumb-sep"><svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-chev-r" /></svg></span>
                <a class="crumb@(crumb.Id == Model.Current!.Id ? " last" : "")"
                   asp-page="Index" asp-route-id="@crumb.Id">@crumb.Name</a>
            }
        </nav>

        @if (canCreateFolder)
        {
            <button class="btn" type="button" id="newFolderBtn">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-plus" /></svg>Создать папку
            </button>
        }

        @* В самой папке отдела не заводят ни папок, ни файлов: работают
           внутри «Общей» и «Внутренней работы», у которых понятно, кто
           их видит. Файл, лежащий между ними, этого ответа не имеет. *@
        @if (canWrite && Model.StorageConfigured
             && (Model.Current is not { IsDepartment: true } || Model.IsAdmin))
        {
            <button class="btn primary" type="button" id="uploadBtn">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-upload" /></svg>Загрузить
            </button>
        }

        @* Остаётся ссылкой на отдельную страницу: без JavaScript окно
           не откроется, а написать объявление человек должен мочь всегда.
           Код страницы перехватывает нажатие и показывает ту же форму
           окном — не уходя из папки, в которую вешают. *@
        @if (Model.CanPublishHere)
        {
            <a class="btn" id="newAnnBtn"
               asp-page="/Announcements/Create" asp-route-folderId="@Model.Current!.Id">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><use href="#i-mega" /></svg>Объявление
            </a>
        }

        @* Корзина у каждого раздела своя и живёт внутри него: общего
           списка «что удалено по всему порталу» в меню больше нет.
           Ведёт она всегда в раздел — файл из подпапки попадает
           в корзину своего раздела. *@
        @if (Model.Current is not null)
        {
            <a class="icon-btn back-btn" title="Корзина раздела" aria-label="Корзина раздела"
               asp-page="Trash" asp-route-id="@Model.RootFolderId">
                <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trash" /></svg>
            </a>
        }

        @if (canManageCurrent)
        {
            <a class="icon-btn back-btn" title="Управление папкой" aria-label="Управление папкой"
               asp-page="Settings" asp-route-id="@Model.Current!.Id">
                <svg class="ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-info" /></svg>
            </a>
        }

        @* Порядок сортировки живёт в адресе страницы: ссылку с нужным
           порядком можно послать коллеге. Без JavaScript останется кнопка. *@
        <form method="get" class="sortform">
            @if (Model.Current is not null)
            {
                <input type="hidden" name="id" value="@Model.Current.Id" />
            }
            @if (Model.IsSearching)
            {
                <input type="hidden" name="q" value="@Model.Query" />
            }

            <label class="sr-only" for="sortSel">Порядок</label>
            <select class="sel" id="sortSel" name="sort">
                <option value="name" selected="@(Model.SortMode == "name")">По имени</option>
                <option value="date" selected="@(Model.SortMode == "date")">По дате</option>
                <option value="size" selected="@(Model.SortMode == "size")">По размеру</option>
                <option value="type" selected="@(Model.SortMode == "type")">По типу</option>
            </select>

            <noscript><button class="btn" type="submit">Показать</button></noscript>
        </form>

        <div class="vt" role="group" aria-label="Вид списка">
            <button id="gridBtn" class="on" type="button" title="Плитка">
                <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><use href="#i-grid" /></svg>
            </button>
            <button id="listBtn" type="button" title="Список">
                <svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><use href="#i-list" /></svg>
            </button>
        </div>
    </div>

    @if (Model.IsSearching)
    {
        <p class="search-note">
            Найдено: <b>@Model.FoundCount</b> по запросу «@Model.Query»
            @(Model.FoundFolders.Count > 0 && Model.SearchResults.Count > 0
                ? $"(папок: {Model.FoundFolders.Count}, файлов: {Model.SearchResults.Count})"
                : "")
            @(Model.Current is null ? "во всём хранилище" : $"в папке «{Model.Current.Name}» и вложенных")
            — <a asp-page="Index" asp-route-id="@Model.Current?.Id">очистить</a>
        </p>
    }

    @* ---------- Объявления папки ----------

       Отдельной ленты объявлений в портале нет: объявление висит на папке
       и читается там же, где лежат документы отдела. Врезка стоит НАД
       списком файлов, потому что новость устаревает, а файлы — нет:
       то, что нужно прочитать один раз и сегодня, должно попадаться
       на глаза раньше того, чем пользуются каждый день.

       Открытие папки отмечает её объявления прочитанными — см. LoadAsync. *@
    @if (Model.Announcements.Count > 0)
    {
        @* Карточки стоят сеткой, а не колонкой в одну ширину: на широком
           экране колонка в 860 пикселей оставляла справа пустое поле
           в пол-экрана. Сетка сама решает, сколько колонок помещается,
           а важное и закреплённое занимает всю ширину — оно и должно
           бросаться в глаза первым. *@
        @* ---------- Свернуть объявления ----------

           Объявления стоят над файлами, потому что новость устаревает,
           а файлы нет. Но тот, кто пришёл за документом в двадцатый раз
           за день, уже всё прочитал, и лента отодвигает ему работу вниз.

           Поэтому у блока есть язычок на нижней границе: тонкая черта
           по центру, какой обычно помечают «потяни». Пока на блок
           не навели, она еле видна и ничего не просит; при наведении
           проявляется и подписывается. Свёрнутое состояние помнится
           по папке — человек сворачивает один раз, а не каждый заход. *@
        <div class="ann-fold" data-ann-fold="@Model.Current?.Id">
            <div class="ann-fold-body">
                <div class="ann-list folder-ann">
                    @foreach (var item in Model.Announcements)
                    {
                        @await Html.PartialAsync("_Announcement",
                            new AnnouncementCard(
                                item,
                                Model.CanModifyAnnouncement(item),
                                Model.ViewsOf(item),
                                Model.Current?.DepartmentRole))
                    }
                </div>
            </div>

            <button class="ann-handle" type="button" data-ann-toggle
                    aria-expanded="true" title="Свернуть объявления">
                <span class="ann-handle-bar"></span>
                <span class="ann-handle-text">
                    <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-chev-u" /></svg>
                    <span data-ann-label>Свернуть</span>
                </span>
            </button>
        </div>
    }

    @* ---------- Новое объявление ----------

       Форма настоящая и живёт на странице; окно её переносит, а не
       пересобирает. Поэтому работают и проверка на сервере, и загрузка
       файла, и защита от подделки запроса. *@
    @if (Model.CanPublishHere)
    {
        <div id="newAnnHolder" hidden>
            <form method="post" asp-page-handler="AnnCreate" enctype="multipart/form-data"
                  id="newAnnForm" class="assigned-form">

                <input type="hidden" name="folderId" value="@Model.Current!.Id" />

                <p class="hint">
                    @if (Model.Current.DepartmentRole == Portal.Web.Data.DepartmentRoles.Internal)
                    {
                        <b>Внутренний контур.</b> @:Объявление увидят только сотрудники отдела.
                    }
                    else
                    {
                        <b>Общий контур.</b> @:Объявление увидят все сотрудники портала.
                    }
                </p>

                <div class="field">
                    <label for="annTitle">Заголовок</label>
                    <input type="text" id="annTitle" name="title" maxlength="200" required autocomplete="off" />
                </div>

                <div class="field">
                    <label for="annBody">Текст</label>
                    <textarea id="annBody" name="body" rows="8" maxlength="10000" required data-format></textarea>
                    <span class="hint">
                        Правое нажатие по тексту — выделение <strong>жирным</strong> и
                        <mark>жёлтым</mark>. Разметка HTML не поддерживается намеренно.
                    </span>
                </div>

                <div class="field">
                    <label for="annFiles">Вложения</label>

                    <label class="file-pick">
                        <input type="file" name="attachments" id="annFiles" multiple data-file-pick />
                        <span class="file-pick-btn">
                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-upload" /></svg>Выбрать файл
                        </span>
                        <span class="file-pick-name" data-file-name>не выбран</span>
                    </label>

                    <span class="hint">
                        Картинки показываются прямо в объявлении, остальное — ссылкой.
                    </span>
                </div>

                <div class="form-actions">
                    <button class="btn primary" type="submit">Опубликовать</button>
                    <button class="btn" type="button" id="cancelAnn">Отмена</button>
                </div>
            </form>
        </div>
    }

    @* ---------- Содержимое ----------
       Данные для кода страницы передаются через data-атрибуты, а не через
       вставленный <script>: политика безопасности запрещает встроенные
       скрипты, и это правильно — так на страницу не попадёт чужой код. *@
    @* Пределы едут на страницу числами, чтобы браузер мог сказать «этот файл
       больше разрешённого» ДО отправки, а не после того как человек прождал
       передачу гигабайта по каналу между офисами. Проверка на сервере при этом
       никуда не девается (UploadValidator) — здесь только удобство. *@
    <div class="files-area" id="filesArea"
         data-folder-id="@(Model.Current?.Id.ToString() ?? "")"
         data-can-write="@canWrite.ToString().ToLowerInvariant()"
         data-can-create-folder="@canCreateFolder.ToString().ToLowerInvariant()"
         @* Отдел заводится только в корне и только администратором:
            от этого зависит, какое окно показать при создании папки. *@
         data-can-create-department="@((Model.Current is null && Model.IsAdmin).ToString().ToLowerInvariant())"
         data-max-file-size="@Model.MaxFileSizeBytes"
         data-quota="@(Model.QuotaBytes?.ToString() ?? "")"
         data-used="@Model.UsedBytes"
         data-blocked="@string.Join(" ", Model.BlockedExtensions)">

        <div id="filesContainer">
            @if (empty)
            {
                <div class="empty">
                    @if (Model.IsSearching)
                    {
                        <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-search" /></svg>
                        <b>Ничего не найдено</b>
                        <p>Поиск идёт по именам файлов и папок и только там, куда у вас есть доступ.</p>
                    }
                    else
                    {
                        @FileIcons.Folder(70)
                        <b>Папка пуста</b>
                        <p>
                            @if (canWrite)
                            {
                                @:Перетащите файлы сюда или нажмите «Загрузить»
                            }
                            else if (canCreateFolder)
                            {
                                @:Нажмите правой кнопкой, чтобы создать папку
                            }
                            else
                            {
                                @:Здесь пока ничего нет
                            }
                        </p>
                    }
                </div>
            }
            else
            {
                @* Один и тот же список выводится дважды — плитками и строками.
                   Переключение видом, а не перерисовкой: так вид меняется
                   мгновенно и не требует ещё одного запроса к серверу.
                   Данных немного, лишний вес страницы незаметен. *@
                <partial name="_FileGrid" model="Model.Entries" />
                <partial name="_FileList" model="Model.Entries" />
            }
        </div>

        @if (canWrite)
        {
            <div class="drop-overlay">
                <svg class="ic" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><use href="#i-upload" /></svg>
                Отпустите файлы для загрузки
            </div>
        }
    </div>

    @if (canWrite && Model.StorageConfigured)
    {
        <input type="file" id="fileInput" name="uploads" multiple hidden />
    }

    @* Скрытая форма нужна ради antiforgery-токена: из неё его берёт
       код страницы для всех действий, которые меняют данные. *@
    <form method="post" asp-page-handler="CreateFolder" hidden></form>
</section>
