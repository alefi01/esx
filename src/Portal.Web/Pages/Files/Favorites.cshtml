@page
@using Portal.Web.Pages.Shared
@model Portal.Web.Pages.Files.FavoritesModel
@{
    ViewData["Title"] = "Избранное";
}

<section class="view active">
    <div class="view-head">
        <h2>Избранное</h2>
        <span class="sub">@(Model.IsEmpty ? "Пока ничего не отмечено" : Model.Entries.Count + " объектов")</span>
    </div>

    @* Тот же список, что и в разделе «Файлы», и тот же код страницы:
       выделение, контекстное меню и предпросмотр работают одинаково. *@
    <div class="files-area" id="filesArea"
         data-folder-id=""
         data-can-write="false"
         data-can-create-folder="false">

        <div id="filesContainer">
            @if (Model.IsEmpty)
            {
                <div class="empty">
                    <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-star" /></svg>
                    <b>Пока пусто</b>
                    <p>Отмечайте важные файлы звёздочкой — они появятся здесь</p>
                </div>
            }
            else
            {
                <partial name="_FileGrid" model="Model.Entries" />
                <partial name="_FileList" model="Model.Entries" />
            }
        </div>
    </div>

    @* Скрытая форма нужна ради antiforgery-токена: из неё его берёт
       код страницы, когда снимает звёздочку. *@
    <form method="post" hidden></form>
</section>
