@page "{id:int}"
@using Portal.Web.Data
@model Portal.Web.Pages.Files.SettingsModel
@{
    ViewData["Title"] = $"Настройки папки: {Model.Folder?.Name}";
}

<section class="view active">


<nav class="breadcrumbs">
    <a asp-page="Index">Файлы</a>
    @foreach (var crumb in Model.Breadcrumbs)
    {
        <span>/</span>
        <a asp-page="Index" asp-route-id="@crumb.Id">@crumb.Name</a>
    }
</nav>

<h1>Настройки папки «@Model.Folder?.Name»</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert ok" role="status">@Model.StatusMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert err" role="alert">@Model.ErrorMessage</div>
}

@* ---------- Отдел ----------

   Раздел виден только на папке верхнего уровня: отделом может быть
   только она. Начальников назначает администратор — это делегирование
   прав на целую ветку хранилища, и делать это мимоходом нельзя.

   Начальник свою папку тут видит, но список начальников менять
   не может: иначе через полгода никто не скажет, кто кем назначен. *@
@if (Model.IsTopLevel)
{
    <div class="card">
        <h2>Отдел</h2>

        @if (!Model.IsAdmin)
        {
            @if (Model.Folder!.IsDepartment)
            {
                <p class="hint">
                    Это папка отдела.
                    @if (Model.Heads.Count > 0)
                    {
                        <text>Начальники: @string.Join(", ", Model.Heads.Select(h => h.DisplayName)).</text>
                    }
                    else
                    {
                        <text>Начальник не назначен — папкой управляет администратор портала.</text>
                    }
                </p>
            }
            else
            {
                <p class="hint">Обычная папка: без начальника и без объявлений.</p>
            }
        }
        else
        {
            <form method="post" asp-page-handler="Department" asp-route-id="@Model.Folder?.Id">
                <label class="fs-check">
                    <input type="checkbox" name="isDepartment" value="true"
                           @(Model.Folder!.IsDepartment ? "checked" : "") />
                    <span>Это папка отдела</span>
                </label>

                <p class="hint">
                    У отдела есть начальники, свои объявления и две папки внутри:
                    «@Portal.Web.Services.Storage.Departments.PublicFolderName» — для всего портала,
                    «@Portal.Web.Services.Storage.Departments.InternalFolderName» — по правам,
                    которые расставит начальник. Недостающие подпапки будут созданы.
                </p>

                @if (Model.Folder!.IsDepartment && Model.Heads.Count == 0)
                {
                    <div class="alert warn" role="alert">
                        <strong>Начальник не назначен.</strong>
                        Папкой управляет только администратор портала, объявления отдела вешать некому.
                    </div>
                }

                <div class="field">
                    <label>Начальники отдела</label>

                    @if (Model.HeadCandidates.Count == 0)
                    {
                        <p class="hint">
                            Назначать некого. Начальник должен состоять в группе
                            <code>@Model.HeadGroup</code> и хотя бы раз войти в портал —
                            после этого он появится в списке.
                        </p>
                    }
                    else
                    {
                        <div class="people">
                            @foreach (var candidate in Model.HeadCandidates)
                            {
                                var chosen = Model.Heads.Any(h =>
                                    string.Equals(h.UserName, candidate.UserName, StringComparison.OrdinalIgnoreCase));

                                <label class="member-row member-row--static">
                                    <input type="checkbox" name="heads" value="@candidate.UserName"
                                           @(chosen ? "checked" : "") />
                                    <div><b>@candidate.DisplayName</b><span>@candidate.UserName</span></div>
                                </label>
                            }
                        </div>
                    }
                </div>

                <button class="btn primary" type="submit">Сохранить отдел</button>
            </form>
        }
    </div>
}

<div class="card">
    <h2>Ограничения и хранение</h2>

    <form method="post" asp-page-handler="Save" asp-route-id="@Model.Folder?.Id">
        <div asp-validation-summary="All" class="alert err"></div>

        <div class="field field--check">
            <label>
                <input asp-for="Input.InheritPermissions" type="checkbox" />
                Наследовать права родительской папки
            </label>
            <p class="hint">
                Включено — к правам этой папки добавляются права всех папок выше по дереву.
                Выключено — действуют только права, назначенные здесь: папка становится
                закрытой даже для тех, кто имеет доступ к родительской.
                Администраторы портала (группа <code>@Model.AdminGroup</code>) попадают сюда в любом случае.
            </p>
        </div>

        <div class="field">
            <label asp-for="Input.MaxFileSizeMb">Предел размера одного файла, МБ</label>
            <input asp-for="Input.MaxFileSizeMb" type="number" min="0"
                   placeholder="не задано — как у родителя" />
            <span asp-validation-for="Input.MaxFileSizeMb" class="err"></span>
            <p class="hint">
                Пусто — берётся значение родительской папки, а если и там пусто —
                общее по умолчанию (@Model.DefaultMaxMb МБ).
                <strong>0 — без ограничения.</strong>
                Сейчас действует:
                <strong>
                    @(Model.EffectiveMaxFileSize > 0
                        ? Model.FormatSize(Model.EffectiveMaxFileSize)
                        : "без ограничения")
                </strong>.
                Верхний предел для всего портала —
                @(Model.AbsoluteMaxMb > 0 ? $"{Model.AbsoluteMaxMb} МБ" : "не задан").
            </p>
        </div>

        <div class="field">
            <label asp-for="Input.QuotaMb">Квота на объём папки, МБ</label>
            <input asp-for="Input.QuotaMb" type="number" min="1" placeholder="не задано — без ограничения" />
            <span asp-validation-for="Input.QuotaMb" class="err"></span>
            <p class="hint">
                Сейчас занято: <strong>@Model.FormatSize(Model.UsedBytes)</strong>@(Model.EffectiveQuota is { } q ? $" из {Model.FormatSize(q)}" : ", квота не задана").
                В занятое место входят и файлы в корзине — они всё ещё лежат на диске.
            </p>
        </div>

        <div class="field">
            <label asp-for="Input.RetentionDays">Автоудаление файлов папки, дней</label>
            <input asp-for="Input.RetentionDays" type="number" min="1" max="3650"
                   placeholder="пусто — не удалять" />
            <span asp-validation-for="Input.RetentionDays" class="err"></span>
            <p class="hint">
                По умолчанию выключено — файлы лежат сколько угодно. Стираются они не сразу, а попадают в корзину,
                где лежат ещё @Model.TrashDays дн. — есть время заметить ошибку в настройке.
                На подпапки этот срок НЕ распространяется: у каждой папки он свой.
                @if (Model.Folder?.RetentionLastRunAt is { } last)
                {
                    <span>Последняя проверка: @last.ToLocalTime().ToString("dd.MM.yyyy HH:mm").</span>
                }
            </p>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn primary">Сохранить</button>
            <a class="btn" asp-page="Index" asp-route-id="@Model.Folder?.Id">Назад к папке</a>
        </div>
    </form>
</div>

<div class="card">
    <h2>Права доступа</h2>

    <p class="hint">
        Права выдаются группам Active Directory, а не отдельным людям.
        Указывайте короткое имя группы (sAMAccountName) — точно так, как оно
        записано в оснастке «Пользователи и компьютеры».
    </p>

    @if (Model.Permissions.Count == 0)
    {
        <p class="hint">
            На эту папку напрямую не выдано ни одного права.
            @if (Model.Folder?.InheritPermissions == true)
            {
                <span>Действуют права, унаследованные от папок выше.</span>
            }
            else
            {
                <span><strong>Наследование выключено — папку видят только администраторы портала.</strong></span>
            }
        </p>
    }
    else
    {
        <table class="table">
            <thead>
            <tr>
                <th>Группа</th>
                <th>Уровень</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var permission in Model.Permissions)
            {
                <tr>
                    <td>
                        <code>@permission.GroupName</code>
                        <span class="dim">@(permission.IsUser ? "сотрудник" : "группа")</span>
                    </td>
                    <td>@permission.Access</td>
                    <td>
                        <form method="post" asp-page-handler="RemovePermission"
                              asp-route-id="@Model.Folder?.Id" asp-route-permissionId="@permission.Id"
                              class="inline-form">
                            <button type="submit" class="link danger">Убрать</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <h3>Выдать доступ</h3>

    <form method="post" asp-page-handler="AddPermission" asp-route-id="@Model.Folder?.Id" class="row-form">
        <input asp-for="NewPermission.GroupName" placeholder="Имя группы AD" maxlength="256" />

        <select asp-for="NewPermission.Access">
            <option value="@FolderAccess.Read">Чтение — видеть и скачивать</option>
            <option value="@FolderAccess.Write">Запись — загружать файлы и создавать подпапки</option>
            <option value="@FolderAccess.Manage">Управление — удалять и менять права</option>
        </select>

        <button type="submit" class="btn primary">Добавить</button>
    </form>

    <p class="hint">
        Если группа уже есть в списке, её уровень будет заменён на выбранный.
        Права разных групп складываются: у человека действует наибольший из полученных уровней.
    </p>
</div>
</section>
