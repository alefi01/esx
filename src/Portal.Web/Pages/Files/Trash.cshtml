@page "{id:int}"
@using Portal.Web.Pages.Shared
@model Portal.Web.Pages.Files.TrashModel
@{
    ViewData["Title"] = $"Корзина раздела «{Model.Root?.Name}»";
}

<section class="view active">

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <span data-flash="@Model.StatusMessage" data-flash-kind="ok" hidden></span>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <span data-flash="@Model.ErrorMessage" data-flash-kind="danger" hidden></span>
    }

    <nav class="crumbs" aria-label="Путь">
        <a class="crumb" asp-page="Index">
            <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-home" /></svg>Файлы
        </a>
        <span class="crumb-sep"><svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-chev-r" /></svg></span>
        <a class="crumb" asp-page="Index" asp-route-id="@Model.Root?.Id">@Model.Root?.Name</a>
        <span class="crumb-sep"><svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-chev-r" /></svg></span>
        <span class="crumb last">Корзина</span>
    </nav>

    <div class="view-head">
        <h2>Корзина раздела «@Model.Root?.Name»</h2>
        <span class="sub">Файлы хранятся @Model.RetentionDays дн., потом стираются с диска безвозвратно</span>

        @if (Model.Items.Count > 0)
        {
            <form method="post" asp-page-handler="PurgeAll" class="head-form">
                <button class="btn danger" type="submit"
                        data-confirm="Будут безвозвратно удалены объекты: @Model.Items.Count."
                        data-confirm-title="Очистить корзину?"
                        data-confirm-ok="Очистить">
                    <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trash" /></svg>Очистить корзину
                </button>
            </form>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty">
            <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-trash" /></svg>
            <b>Корзина пуста</b>
            <p>Здесь будет появляться удалённое из этого раздела</p>
        </div>
    }
    else
    {
        <p class="search-note">
            Файлов: <b>@Model.Items.Count</b>,
            занимают <b>@Portal.Web.Pages.Files.TrashModel.FormatSize(Model.TotalBytes)</b>
        </p>

        @foreach (var item in Model.Items)
        {
            <div class="trash-row">
                <div class="ficon">@FileIcons.File(item.File.OriginalName, 30)</div>

                <div class="fname" title="@item.File.OriginalName">@item.File.OriginalName</div>

                <div class="muted hide-s">@item.FolderPath</div>
                <div class="muted hide-s">удалил @item.DeletedBy</div>
                <div class="muted">до @item.PurgeAt.ToLocalTime().ToString("dd.MM.yyyy")</div>

                @if (item.CanRestore)
                {
                    <form method="post" asp-page-handler="Restore" asp-route-fileId="@item.File.Id" class="head-form">
                        <button class="btn sm" type="submit">
                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-restore" /></svg>Восстановить
                        </button>
                    </form>
                }

                @* Стереть насовсем может тот, кто управляет папкой,
                   и тот, кто сам это удалил: отменить такое нельзя,
                   и право здесь строже, чем на восстановление. *@
                @if (item.CanPurge)
                {
                    <form method="post" asp-page-handler="Purge" asp-route-fileId="@item.File.Id" class="head-form">
                        <button class="btn sm danger" type="submit" title="Стереть окончательно"
                                data-confirm="«@item.File.OriginalName» будет стёрт безвозвратно."
                                data-confirm-title="Удалить навсегда?"
                                data-confirm-ok="Удалить">
                            <svg class="ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-x" /></svg>
                        </button>
                    </form>
                }
            </div>
        }
    }
</section>
