@page
@using Portal.Web.Pages.Shared
@model Portal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

@*
    Главная — «рабочий стол»: часы, крупный поиск и то, что появилось,
    пока человека не было. Лента объявлений целиком живёт в своём разделе;
    повторять её здесь значило бы показывать одно и то же дважды.

    Строки поиска в шапке на этой странице нет намеренно (см. _Layout):
    две строки поиска на одном экране — это один и тот же вопрос, заданный
    дважды.
*@
<section class="view active home@(Model.NothingToShow ? " home--empty" : "")">

    <div class="home-top">

        @* Часы. Время ставит код страницы и обновляет раз в секунду:
           отрисованное сервером отстало бы уже к моменту показа, а на
           часах это заметно сразу. До первой отрисовки показывается
           серверное время — чтобы не мигало пустотой. *@
        <div class="clock" id="clock">
            <div class="clock-time" id="clockTime">@DateTime.Now.ToString("HH:mm")</div>
            <div class="clock-date" id="clockDate">
                @DateTime.Now.ToString("dddd, d MMMM", System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))
            </div>
        </div>

        <p class="home-hello">
            @(Model.Greeting + ", " + Model.DisplayName
              + (string.IsNullOrEmpty(Model.OfficeName) ? "" : " · " + Model.OfficeName))
        </p>

        @* Крупный поиск. Обычная форма методом GET, как и в шапке:
           работает без JavaScript, а адрес результата можно послать
           коллеге ссылкой. *@
        <form class="home-search" method="get" asp-page="/Files/Index" role="search">
            <svg class="ic" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><use href="#i-search" /></svg>
            <input type="text" name="q" id="homeSearch" autocomplete="off" autofocus
                   placeholder="Поиск файлов и папок" aria-label="Поиск файлов и папок" />
            <button class="btn primary" type="submit">Найти</button>
        </form>
    </div>

    @if (Model.DatabaseUnavailable)
    {
        <div class="alert err" role="alert">
            <strong>Объявления сейчас недоступны.</strong>
            Не удалось получить данные — сообщите администратору.
            Остальные разделы портала работают.
        </div>
    }
    else if (!Model.NothingToShow)
    {
        @* Два столбца: слева новое, справа закреплённое. Закреплённое
           справа и уже — это фон, а не новость: его читают один раз,
           а висеть оно должно постоянно. *@
        <div class="home-cols">

            <div class="home-col-main">
                @if (Model.Items.Count == 0)
                {
                    <div class="side-head">
                        <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-mega" /></svg>
                        Новые объявления
                    </div>

                    <div class="home-clear">
                        <svg class="ic" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>
                        <div>
                            <b>Новых объявлений нет</b>
                            <span>
                                @if (Model.TotalCount > 0)
                                {
                                    <a asp-page="/Announcements/Index">Посмотреть всю ленту (@Model.TotalCount)</a>
                                }
                                else
                                {
                                    @:Здесь появятся сообщения, которые должны увидеть все сотрудники
                                }
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="side-head home-unread-head">
                        <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-mega" /></svg>
                        Новые объявления
                        <span class="unread-count">@Model.UnreadCount</span>

                        @* Отметка «прочитано» ставится ЯВНО, кнопкой. Раньше главная
                           отмечала всё сама при открытии — с лентой «всё подряд» это
                           было безобидно, а со списком «только новое» означало бы,
                           что список исчезает от случайного захода на страницу. *@
                        <form method="post" asp-page-handler="MarkRead" class="home-mark">
                            <button class="btn sm" type="submit">
                                <svg class="ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><use href="#i-check" /></svg>Прочитано
                            </button>
                        </form>

                        <a class="feed-all" asp-page="/Announcements/Index">Вся лента</a>
                    </div>

                    <div class="ann-list">
                        @foreach (var item in Model.Items)
                        {
                            @await Html.PartialAsync("_Announcement", new AnnouncementCard(item, Model.CanModify(item)))
                        }
                    </div>

                    @if (Model.HasMore)
                    {
                        <p class="feed-more">
                            <a asp-page="/Announcements/Index">
                                Ещё @(Model.UnreadCount - Model.Items.Count) непрочитанных →
                            </a>
                        </p>
                    }
                }
            </div>

            @if (Model.Pinned.Count > 0)
            {
                <aside class="home-col-side" aria-label="Закреплённые объявления">
                    <div class="side-head">
                        <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-pin" /></svg>
                        Закреплённое
                        <span class="side-count">@Model.Pinned.Count</span>
                    </div>

                    @foreach (var item in Model.Pinned)
                    {
                        @* Карточка урезанная: заголовок, начало текста и дата.
                           Полный текст — по ссылке в ленте. Правый столбец
                           узкий, и целые объявления в нём превратились бы
                           в стену текста, которую перестают читать.

                           Текст здесь выводится КАК ТЕКСТ, без превращения
                           адресов в ссылки. Причина не в лени: вся карточка
                           сама по себе ссылка, а ссылка внутри ссылки —
                           недопустимая разметка, и браузер молча разрывает
                           внешнюю. Карточка при этом разваливается. Полный
                           текст с рабочими ссылками — в ленте объявлений. *@
                        <a class="pin-card@(item.IsImportant ? " important" : "")"
                           asp-page="/Announcements/Index" asp-fragment="a@item.Id">
                            <b>@item.Title</b>
                            <span class="pin-body">@item.Body</span>
                            <span class="pin-foot">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy") · @item.AuthorDisplayName</span>
                        </a>
                    }
                </aside>
            }
        </div>
    }
</section>
