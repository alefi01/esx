@page
@model Portal.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="home narrow">
    @* ---------- Приветствие ---------- *@
    <div class="hero">
        <div class="hero__text">
            <h1>@Model.Greeting, @Model.DisplayName</h1>
            <p>
                Это корпоративный портал.
                @if (!string.IsNullOrEmpty(Model.OfficeName))
                {
                    <span>Вы в офисе «@Model.OfficeName».</span>
                }
            </p>
        </div>

        <div class="hero__links">
            <a class="tilelink" asp-page="/Files/Index">
                <span class="tilelink__icon"><svg class="icon"><use href="#i-folder"></use></svg></span>
                <span>
                    <strong>Файлы</strong>
                    <span class="muted">Общие документы и папки отделов</span>
                </span>
            </a>

            <a class="tilelink" asp-page="/Messages/Index">
                <span class="tilelink__icon"><svg class="icon"><use href="#i-chat"></use></svg></span>
                <span>
                    <strong>Переписки</strong>
                    <span class="muted">Личные сообщения и рабочие группы</span>
                </span>
            </a>

            @if (Model.CanPublish)
            {
                <a class="tilelink" asp-page="/Announcements/Create">
                    <span class="tilelink__icon"><svg class="icon"><use href="#i-pen"></use></svg></span>
                    <span>
                        <strong>Написать объявление</strong>
                        <span class="muted">Увидят все сотрудники</span>
                    </span>
                </a>
            }
        </div>
    </div>

    @* ---------- Лента объявлений ---------- *@
    <div class="feed">
        <div class="feed__head">
            <h2>Объявления</h2>
            <a asp-page="/Announcements/Index">Все объявления</a>
        </div>

        @if (Model.DatabaseUnavailable)
        {
            <div class="alert alert--error" role="alert">
                <strong>Объявления сейчас недоступны.</strong>
                Не удалось получить данные — сообщите администратору.
                Остальные разделы портала работают.
            </div>
        }
        else if (Model.Items.Count == 0)
        {
            <div class="empty">
                <svg class="icon icon--xl"><use href="#i-bell"></use></svg>
                <p>Объявлений пока нет</p>
                @if (Model.CanPublish)
                {
                    <p class="muted">Вы можете написать первое.</p>
                }
            </div>
        }

        @foreach (var item in Model.Items)
        {
            @await Html.PartialAsync("_Announcement",
                new Portal.Web.Pages.Shared.AnnouncementCard(item, Model.CanModify(item)))
        }

        @if (Model.HasMore)
        {
            <p class="feed__more">
                <a class="btn" asp-page="/Announcements/Index">Смотреть все объявления</a>
            </p>
        }
    </div>
</div>
