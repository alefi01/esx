@page
@using Portal.Web.Data
@model Portal.Web.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Журнал действий";
}

<h1>Журнал действий с файлами</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert--ok" role="status">@Model.StatusMessage</div>
}

<div class="card">
    <h2>Хранение</h2>

    <dl class="facts">
        <dt>Записей в журнале</dt>
        <dd>
            @Model.TotalEntries
            @if (Model.OldestEntryAt is { } oldest)
            {
                <span class="muted">самая давняя — @oldest.ToLocalTime().ToString("dd.MM.yyyy")</span>
            }
        </dd>

        <dt>Срок хранения</dt>
        <dd>
            @if (Model.RetentionDays > 0)
            {
                <span>@Model.RetentionDays дн.</span>
                @if (Model.OldEntries > 0)
                {
                    <span class="badge badge--warn">старше срока: @Model.OldEntries</span>
                }
            }
            else
            {
                <span>не задан — журнал хранится вечно</span>
            }
            <p class="hint">
                Настройка <code>Storage:AuditRetentionDays</code> в
                <code>appsettings.Production.json</code>. Старые записи убирает
                фоновая уборка раз в @Model.CleanupHours ч; кнопкой ниже
                это можно сделать сразу.
            </p>
        </dd>
    </dl>

    <div class="row-form">
        <form method="post" asp-page-handler="PurgeOld" data-busy-form>
            <button type="submit" class="btn" data-confirm-action
                    data-confirm-text="Убрать записи журнала старше срока хранения? Действие необратимо."
                    data-confirm-ok="Убрать старые">
                <svg class="icon"><use href="#i-trash"></use></svg>
                Убрать старые записи
            </button>
        </form>

        <form method="post" asp-page-handler="PurgeAll" data-busy-form>
            <button type="submit" class="btn btn--danger" data-confirm-action
                    data-confirm-text="Стереть весь журнал действий? Восстановить его будет нельзя. Сам факт очистки останется в журнале первой строкой."
                    data-confirm-ok="Стереть всё">
                <svg class="icon"><use href="#i-trash"></use></svg>
                Очистить журнал полностью
            </button>
        </form>
    </div>
</div>

@if (Model.DatabaseError is not null)
{
    <div class="alert alert--error" role="alert">
        Не удалось прочитать журнал: <code>@Model.DatabaseError</code>
    </div>
}

<div class="card">
    <form method="get" class="row-form">
        <input asp-for="UserFilter" placeholder="логин" />
        <input asp-for="TargetFilter" placeholder="файл или папка" />

        <select asp-for="ActionFilter">
            <option value="">все действия</option>
            @foreach (var action in Enum.GetValues<AuditAction>())
            {
                <option value="@action">@Portal.Web.Pages.Admin.AuditModel.Describe(action)</option>
            }
        </select>

        <button type="submit" class="button button--inline">Показать</button>
        <a class="button" asp-page="Audit">Сбросить</a>
    </form>
</div>

<div class="card">
    @if (Model.Entries.Count == 0)
    {
        <p class="hint">Записей нет.</p>
    }
    else
    {
        <table class="table">
            <thead>
            <tr>
                <th>Когда</th>
                <th>Кто</th>
                <th>Адрес</th>
                <th>Действие</th>
                <th>Объект</th>
                <th>Подробности</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td>@entry.UserName</td>
                    <td><code>@(entry.RemoteIp ?? "—")</code></td>
                    <td>@Portal.Web.Pages.Admin.AuditModel.Describe(entry.Action)</td>
                    <td>@entry.Target</td>
                    <td class="hint">@entry.Details</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="pager">
        @if (Model.PageNumber > 1)
        {
            <a asp-page="Audit" asp-route-pageNumber="@(Model.PageNumber - 1)"
               asp-route-userFilter="@Model.UserFilter" asp-route-actionFilter="@Model.ActionFilter"
               asp-route-targetFilter="@Model.TargetFilter">← Новее</a>
        }

        <span class="hint">Страница @Model.PageNumber из @Model.TotalPages</span>

        @if (Model.PageNumber < Model.TotalPages)
        {
            <a asp-page="Audit" asp-route-pageNumber="@(Model.PageNumber + 1)"
               asp-route-userFilter="@Model.UserFilter" asp-route-actionFilter="@Model.ActionFilter"
               asp-route-targetFilter="@Model.TargetFilter">Старее →</a>
        }
    </nav>
}
