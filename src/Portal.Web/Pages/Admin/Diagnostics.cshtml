@page
@model Portal.Web.Pages.Admin.DiagnosticsModel
@{
    ViewData["Title"] = "Диагностика";
}

<section class="view active">


<div class="card">
    <h1>Диагностика подключения</h1>
    <p class="hint">Раздел виден только членам группы <code>@Model.AdOptions.AdminGroup</code>.</p>

    <dl class="facts">
        <dt>Ваш адрес глазами приложения</dt>
        <dd><code>@(Model.RemoteIp ?? "неизвестен")</code></dd>

        <dt>Определённый офис</dt>
        <dd>@Model.DetectedOffice</dd>

        <dt>Домен</dt>
        <dd><code>@Model.AdOptions.DomainFqdn</code>, корень поиска <code>@Model.AdOptions.BaseDn</code></dd>

        <dt>Режим проверки пароля</dt>
        <dd>
            <code>@Model.AdOptions.AuthMode</code>
            @if (Model.AdOptions.UseSsl)
            {
                <span class="badge badge--ok">LDAPS</span>
            }
            else if (Model.AdOptions.AuthMode == Portal.Web.Configuration.LdapAuthMode.Basic)
            {
                <span class="badge badge--warn">пароль идёт по сети открытым текстом</span>
            }
        </dd>

        <dt>Группа доступа / администраторов</dt>
        <dd><code>@Model.AdOptions.AccessGroup</code> / <code>@Model.AdOptions.AdminGroup</code></dd>
    </dl>
</div>

<div class="card">
    <h2>Контроллеры домена</h2>

    <p class="hint">
        Порядок опроса для вашего адреса. Проверяется TCP-подключение к порту LDAP —
        то есть только доступность узла, без проверки учётных данных.
    </p>

    <table class="table">
        <thead>
        <tr>
            <th>Узел</th>
            <th>Порт</th>
            <th>Состояние</th>
            <th>Время</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var probe in Model.Probes)
        {
            <tr>
                <td><code>@probe.Host</code></td>
                <td>@probe.Port</td>
                <td>
                    @if (probe.Reachable)
                    {
                        <span class="badge badge--ok">отвечает</span>
                    }
                    else
                    {
                        <span class="badge badge--error">нет связи</span>
                        <span class="hint">@probe.Error</span>
                    }
                </td>
                <td>@probe.ElapsedMs мс</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="card">
    <h2>Обзор каталога домена</h2>

    <p class="hint">
        Это НЕ вход в портал. Вход спрашивает у контроллера, верен ли пароль человека;
        обзор — читает дерево подразделений от имени самого приложения, и разрешено ему
        может быть совсем другое. Здесь видно, чем именно кончается попытка,
        когда окно выбора группы показывает пустое дерево.
    </p>

    <dl class="facts">
        <dt>Корень поиска (BaseDn)</dt>
        <dd><code>@Model.AdOptions.BaseDn</code></dd>
    </dl>

    @if (Model.BrowseProbes.Count == 0)
    {
        <p class="hint">Ни одного контроллера домена в настройках нет — обзор невозможен.</p>
    }
    else
    {
        <table class="table">
            <thead>
            <tr>
                <th>Контроллер</th>
                <th>Учётная запись приложения</th>
                <th>Что ответил каталог</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var probe in Model.BrowseProbes)
            {
                <tr>
                    <td>
                        <code>@probe.Controller</code>
                        @if (!string.IsNullOrEmpty(probe.NamingContext))
                        {
                            <br />
                            <span class="hint">корень домена по версии контроллера: <code>@probe.NamingContext</code></span>
                        }
                    </td>
                    <td><code>@probe.BoundAs</code></td>
                    <td>
                        @if (!probe.Reachable)
                        {
                            <span class="badge badge--error">нет связи</span>
                            <span class="hint">@probe.Error</span>
                        }
                        else if (probe.Error is not null)
                        {
                            <span class="badge badge--error">отказ</span>
                            <span class="hint">@probe.Error</span>
                        }
                        else
                        {
                            @* Про корень поиска говорим ОТДЕЛЬНО от результата:
                               портал умеет обойти неверный BaseDn, спросив корень
                               у самого контроллера, — но настройку от этого
                               исправить всё равно надо. *@
                            @if (!string.IsNullOrWhiteSpace(Model.AdOptions.BaseDn) && !probe.BaseFound)
                            {
                                <span class="badge badge--error">корень поиска не найден</span>
                                <span class="hint">
                                    В настройках <code>ActiveDirectory:BaseDn</code> записано
                                    <code>@Model.AdOptions.BaseDn</code> — такого объекта в каталоге нет.
                                    @if (!string.IsNullOrEmpty(probe.NamingContext))
                                    {
                                        <span>Контроллер называет корнем домена <code>@probe.NamingContext</code>; впишите это значение. Пока настройка не исправлена, портал пользуется найденным корнем сам.</span>
                                    }
                                </span>
                            }
                            else if (string.IsNullOrWhiteSpace(Model.AdOptions.BaseDn))
                            {
                                <span class="badge badge--warn">корень поиска не задан</span>
                                <span class="hint">
                                    <code>ActiveDirectory:BaseDn</code> пуст, портал берёт корень
                                    у контроллера: <code>@probe.NamingContext</code>.
                                </span>
                            }

                            @if (probe.Found > 0)
                            {
                                <span class="badge badge--ok">@probe.Found записей</span>
                                <span class="hint">обзор каталога работает</span>
                            }
                            else if (probe.AnyChildren == 0)
                            {
                                <span class="badge badge--warn">на первом уровне пусто</span>
                                <span class="hint">
                                    Запрос без всякого отбора не вернул из корня ни одного объекта.
                                    Так бывает, когда корень указывает на отдельное подразделение,
                                    а не на домен целиком.
                                </span>
                            }
                            else
                            {
                                <span class="badge badge--warn">отбор ничего не выбрал</span>
                                <span class="hint">
                                    На первом уровне лежит объектов: <b>@probe.AnyChildren</b>,
                                    но под отбор обзора (подразделения, группы, люди) не подошёл ни один.
                                    Это случай для разработчика: дело в самом запросе, а не в настройках
                                    и не в правах — пришлите эту строку вместе со списком ниже.
                                </span>
                            }
                        }
                        @if (probe.Sample is { Count: > 0 } && probe.Found == 0)
                        {
                            @* Что именно пришло от контроллера. Показывается только
                               при неудаче: при работающем обзоре это просто шум. *@
                            <ul class="hint probe-sample">
                                @foreach (var line in probe.Sample)
                                {
                                    <li><code>@line</code></li>
                                }
                            </ul>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <h2>База данных</h2>

    <dl class="facts">
        <dt>Состояние при запуске приложения</dt>
        <dd>
            @if (Model.Database.IsReady)
            {
                <span class="badge badge--ok">схема в порядке</span>
            }
            else
            {
                <span class="badge badge--error">ошибка</span>
                <span class="hint">@Model.Database.Error</span>
            }
        </dd>

        <dt>Отвечает сейчас</dt>
        <dd>
            @if (Model.DatabaseRespondsNow)
            {
                <span class="badge badge--ok">да</span>
            }
            else
            {
                <span class="badge badge--error">нет</span>
                <span class="hint">@Model.DatabaseLiveError</span>
            }
        </dd>

        <dt>Объявлений в базе</dt>
        <dd>@(Model.AnnouncementCount?.ToString() ?? "—")</dd>
    </dl>

    <p class="hint">
        Если «при запуске» ошибка, а «сейчас» всё в порядке — базу подняли уже
        после старта портала. Перезапустите пул приложений, чтобы применились
        миграции: <code>Restart-WebAppPool -Name "PortalPool"</code>
    </p>
</div>

<div class="card">
    <h2>Файловое хранилище</h2>

    <dl class="facts">
        <dt>Путь</dt>
        <dd><code>@(string.IsNullOrEmpty(Model.StorageRoot) ? "не задан (Storage:RootPath)" : Model.StorageRoot)</code></dd>

        <dt>Доступно на запись</dt>
        <dd>
            @if (Model.StorageOk)
            {
                <span class="badge badge--ok">да</span>
            }
            else
            {
                <span class="badge badge--error">нет</span>
                <span class="hint">@Model.StorageError</span>
            }
        </dd>

        <dt>Файлов в хранилище</dt>
        <dd>@(Model.FileCount?.ToString() ?? "—")</dd>

        <dt>Занято по данным базы</dt>
        <dd>@(Model.StorageUsedBytes is { } used
                ? Portal.Web.Services.Storage.UploadValidator.Format(used)
                : "—")</dd>
    </dl>

    <p class="hint">
        «Занято» считается по записям в базе, включая корзину.
        Если цифра сильно расходится с реальным размером папки на диске,
        значит там остались файлы, потерявшие запись в базе.
    </p>
</div>

<div class="card">
    <h2>Доступ</h2>

<p class="hint">
    Раздел отвечает на жалобы вида «страница открыта, а ничего не работает»
    и на ошибки 401 в консоли браузера. Портал признаёт человека вошедшим
    по cookie, которую сам же и подписывает; если что-то из этой цепочки
    ломается, здесь будет видно, что именно.
</p>

<dl class="facts">
    <dt>Cookie входа в этом запросе</dt>
    <dd>
        @if (Model.AuthCookiePresent)
        {
            <span class="badge badge--ok">пришла</span>
            <span class="muted">@Model.AuthCookieLength символов</span>
        }
        else
        {
            <span class="badge badge--error">не пришла</span>
        }
    </dd>

    <dt>Способ признания</dt>
    <dd><code>@Model.AuthenticationType</code></dd>

    <dt>Проверено контроллером</dt>
    <dd><code>@Model.AuthenticatedBy</code></dd>

    <dt>Почта из каталога</dt>
    <dd>@(string.IsNullOrEmpty(Model.Email) ? "не указана" : Model.Email)</dd>

    <dt>Группы Active Directory (@Model.Groups.Count)</dt>
    <dd>
        <p class="hint">
            Каждая из них в портале является ролью: права на разделы и папки
            раздаются именно по ним, отдельного списка пользователей портал не ведёт.
        </p>
        <ul class="tags">
            @foreach (var group in Model.Groups)
            {
                <li><code>@group</code></li>
            }
        </ul>
    </dd>

    <dt>Папка ключей шифрования</dt>
    <dd>
        <code>@Model.KeysPath</code><br />
        @if (Model.KeysError is not null)
        {
            <span class="badge badge--error">недоступна</span>
            <span class="muted">@Model.KeysError</span>
        }
        else if (!Model.KeysWritable)
        {
            <span class="badge badge--error">нет прав на запись</span>
        }
        else
        {
            <span class="badge badge--ok">в порядке</span>
            <span class="muted">файлов ключей: @Model.KeyFileCount</span>
        }
    </dd>

    <dt>Отказов с момента запуска</dt>
    <dd>@Model.AuthFailureTotal</dd>
</dl>

@if (Model.KeysError is not null || !Model.KeysWritable)
{
    <div class="alert err" role="alert">
        <strong>Ключи шифрования cookie некуда сохранять.</strong>
        В этом случае .NET создаёт временные ключи в памяти, и при каждом
        перезапуске рабочего процесса IIS все входы разом перестают
        приниматься: страница у человека открыта, а любой запрос с неё
        получает отказ 401. Выдайте пулу приложений право на запись
        в папку <code>App_Data\keys</code>.
    </div>
}

@if (Model.AuthFailures.Count > 0)
{
    <h3>Последние отказы</h3>

    <p class="hint">
        Свежие сверху. Если человек из другого офиса повторит действие сейчас,
        оно появится здесь первой строкой — вместе с причиной.
    </p>

    <table class="table">
        <thead>
        <tr>
            <th>Когда</th>
            <th>Куда</th>
            <th>Причина</th>
            <th>Cookie</th>
            <th>Адрес</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var failure in Model.AuthFailures)
        {
            <tr>
                <td>@failure.At.ToString("dd.MM HH:mm:ss")</td>
                <td><code>@failure.Path</code></td>
                <td>@failure.Reason</td>
                <td>
                    @if (failure.CookiePresent)
                    {
                        <span>пришла, @failure.CookieLength симв.</span>
                    }
                    else
                    {
                        <strong>не пришла</strong>
                    }
                </td>
                <td>@failure.RemoteIp</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Настроенные офисы</h2>

    <table class="table">
        <thead>
        <tr>
            <th>Код</th>
            <th>Название</th>
            <th>Подсети</th>
            <th>Контроллеры домена</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var office in Model.Offices)
        {
            <tr>
                <td><code>@office.Code</code></td>
                <td>@office.Name</td>
                <td>@string.Join(", ", office.Subnets)</td>
                <td>@string.Join(", ", office.DomainControllers)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
</section>
