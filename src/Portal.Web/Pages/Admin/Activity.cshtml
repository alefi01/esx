@page
@using Portal.Web.Data
@model Portal.Web.Pages.Admin.ActivityModel
@{
    ViewData["Title"] = "Активность";
}

<section class="view active">
    <div class="view-head">
        <h2>Лента активности</h2>
        <span class="sub">Последние действия сотрудников. Раздел виден только администраторам</span>
    </div>

    @if (Model.DatabaseError is not null)
    {
        <div class="alert err" role="alert">
            <strong>База данных недоступна.</strong>
            Лента пуста не потому, что ничего не происходило.
            <br /><code>@Model.DatabaseError</code>
        </div>
    }

    @if (Model.Days.Count == 0 && Model.DatabaseError is null)
    {
        <div class="empty">
            <svg class="ic" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><use href="#i-clock" /></svg>
            <b>Пока ничего не происходило</b>
            <p>События появятся здесь, как только кто-нибудь начнёт работать с файлами</p>
        </div>
    }

    @foreach (var day in Model.Days)
    {
        <div class="t-day">@Portal.Web.Pages.Admin.ActivityModel.DayTitle(day.Day)</div>

        @* Вертикальная линия ленты рисуется у списка, а не у каждой строки:
           иначе между строками оставались бы разрывы. *@
        <div class="timeline">
            @foreach (var entry in day.Entries)
            {
                <div class="t-item">
                    <div class="t-dot t-dot--@Portal.Web.Pages.Admin.ActivityModel.ToneOf(entry.Action)">
                        <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#@Portal.Web.Pages.Admin.ActivityModel.IconOf(entry.Action)" /></svg>
                    </div>

                    <div class="t-meta">
                        <b>
                            @(string.IsNullOrWhiteSpace(entry.UserDisplayName) ? entry.UserName : entry.UserDisplayName)
                            <span class="t-what">@Portal.Web.Pages.Admin.ActivityModel.Describe(entry.Action)</span>
                            @entry.Target
                        </b>
                        <time datetime="@entry.At.ToString("O")">
                            @entry.At.ToLocalTime().ToString("HH:mm")@(string.IsNullOrWhiteSpace(entry.Details) ? "" : " · " + entry.Details)
                        </time>
                    </div>
                </div>
            }
        </div>
    }
</section>
