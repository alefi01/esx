@page
@using Portal.Web.Data
@model Portal.Web.Pages.Admin.ActivityModel
@{
    ViewData["Title"] = "Активность";
}

<div class="page-header">
    <div class="page-header__text">
        <h1>Активность</h1>
        <p class="page-header__sub">
            Последние события в портале, свежие сверху. Раздел виден только
            администраторам. Для разбирательств «кто скачал этот документ
            в марте» есть <a asp-page="Audit">журнал</a> с поиском и фильтрами.
        </p>
    </div>
</div>

@if (Model.DatabaseError is not null)
{
    <div class="alert alert--error" role="alert">
        <strong>База данных недоступна.</strong>
        Лента пуста не потому, что ничего не происходило.
        <br />
        <code>@Model.DatabaseError</code>
    </div>
}

<div class="pane narrow">
    @if (Model.Days.Count == 0 && Model.DatabaseError is null)
    {
        <div class="empty">
            <svg class="icon icon--xl"><use href="#i-clock"></use></svg>
            <p>Пока ничего не происходило</p>
            <p class="muted">События появятся здесь, как только кто-нибудь начнёт работать с файлами.</p>
        </div>
    }

    @foreach (var day in Model.Days)
    {
        <div class="t-day">@Portal.Web.Pages.Admin.ActivityModel.DayTitle(day.Day)</div>

        @* Вертикальная линия ленты рисуется у списка, а не у каждой строки:
           иначе между строками оставались бы разрывы. *@
        <div class="timeline">
            @foreach (var entry in day.Entries)
            {
                <div class="t-item">
                    <span class="t-dot t-dot--@Portal.Web.Pages.Admin.ActivityModel.ToneOf(entry.Action)">
                        <svg class="icon icon--xs">
                            <use href="#@Portal.Web.Pages.Admin.ActivityModel.IconOf(entry.Action)"></use>
                        </svg>
                    </span>

                    <div class="t-body">
                        <div class="t-top">
                            <strong>@(string.IsNullOrWhiteSpace(entry.UserDisplayName) ? entry.UserName : entry.UserDisplayName)</strong>
                            <span class="t-what">@Portal.Web.Pages.Admin.ActivityModel.Describe(entry.Action)</span>
                            <time class="t-time" datetime="@entry.At.ToString("O")">
                                @entry.At.ToLocalTime().ToString("HH:mm")
                            </time>
                        </div>

                        <div class="t-target">@entry.Target</div>

                        @if (!string.IsNullOrWhiteSpace(entry.Details))
                        {
                            <div class="t-details">@entry.Details</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
