@page
@model Portal.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Настройки";
}

@*
    Личные настройки. Всё, что здесь есть, касается только того, кто
    открыл страницу: коллеги ничего из этого не заметят.
*@
<section class="view active set-page" data-personal-settings>

    <div class="view-head">
        <h2>Настройки</h2>
        <span class="hint">Только для вас — у коллег останется как было</span>
    </div>

    <div class="card set-card">
        <div class="set-head">
            <h2>Уведомления Windows</h2>
            <span class="set-now" id="notifyState">проверяем…</span>
        </div>

        <div class="set-row">
            <button class="btn" type="button" id="notifyAsk">
                <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-bell" /></svg>Разрешить уведомления
            </button>
        </div>
    </div>

    <div class="card set-card">
        <div class="set-head">
            <h2>Облегчённый режим</h2>
            <span class="set-now">на этом компьютере</span>
        </div>

        <div class="set-row">
            <label class="fs-check">
                <input type="checkbox" id="liteMode" />
                <span>Для слабых компьютеров и медленной сети</span>
            </label>
        </div>
    </div>

</section>
