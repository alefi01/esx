<?xml version="1.0" encoding="utf-8"?>
<!--
  Откуда брать NuGet-пакеты.

  В вашей сети нет интернета, поэтому список источников намеренно очищен
  и оставлена только локальная папка packages/ внутри репозитория.
  Так сборка src/Portal.Web работает сразу после копирования исходников,
  без подготовительных шагов и без попыток куда-то достучаться.

  Что делать, если понадобится новый пакет — см. docs/02-что-скачать.md,
  раздел про сбор пакетов на машине с интернетом.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="packages" />
  </packageSources>
</configuration>
