<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ВНИМАНИЕ: этот проект нужен только для запуска автотестов на машине
         разработки. Для развёртывания портала он не требуется —
         публикуется всегда src/Portal.Web.

         Пакеты ниже в папку packages/ не положены: они тянут около 100 МБ.
         Как получить их для сети без интернета — см. docs/02-что-скачать.md. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />

    <!-- SQLite подменяет PostgreSQL в тестах: он ведёт себя как настоящая
         реляционная база, но не требует установленной СУБД. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />

    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />

    <!-- Версия задана явно и намеренно. Провайдер SQLite по умолчанию тянет
         SQLitePCLRaw 2.1.11, для которой опубликовано уведомление о серьёзной
         уязвимости (GHSA-2m69-gcr7-jv3q). На боевой сервер этот пакет не попадает —
         он только в тестах, — но оставлять предупреждение в сборке не стоит:
         к предупреждениям быстро привыкают и перестают их читать. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Portal.Web\Portal.Web.csproj" />
  </ItemGroup>

</Project>
